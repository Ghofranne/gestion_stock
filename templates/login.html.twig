<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        /* Enhanced background shapes */
        .bg-shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.1;
            animation: float 6s ease-in-out infinite;
        }

        .bg-shape:nth-child(1) {
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.2);
            top: 10%;
            left: 10%;
            animation-delay: 0s;
        }

        .bg-shape:nth-child(2) {
            width: 150px;
            height: 150px;
            background: rgba(255, 255, 255, 0.15);
            bottom: 20%;
            right: 15%;
            animation-delay: 2s;
        }

        .bg-shape:nth-child(3) {
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            top: 50%;
            left: -50px;
            animation-delay: 4s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            33% { transform: translateY(-30px) rotate(5deg); }
            66% { transform: translateY(-15px) rotate(-5deg); }
        }

        .login-container {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(25px);
            padding: 3rem;
            border-radius: 24px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
            width: 100%;
            max-width: 440px;
            position: relative;
            animation: slideUp 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .header {
            text-align: center;
            margin-bottom: 2.5rem;
            position: relative;
        }

        .header::before {
            content: '🔐';
            font-size: 3rem;
            display: block;
            margin-bottom: 1rem;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .header h1 {
            color: #2d3748;
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            background-size: 200% 200%;
            animation: gradientShift 3s ease infinite;
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .header p {
            color: #718096;
            font-size: 1rem;
            font-weight: 400;
        }

        .alert {
            background: linear-gradient(135deg, #fed7d7, #feb2b2);
            color: #c53030;
            padding: 1rem 1.25rem;
            border-radius: 16px;
            margin-bottom: 1.5rem;
            border: 1px solid #fca5a5;
            font-size: 0.9rem;
            animation: shake 0.6s ease-in-out;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .alert::before {
            content: '⚠️';
            font-size: 1.2rem;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }

        .success-alert {
            background: linear-gradient(135deg, #d4edda, #c3e6cb);
            color: #155724;
            border-color: #b8dacd;
        }

        .success-alert::before {
            content: '✅';
        }

        .user-info {
            background: linear-gradient(135deg, #e6fffa, #b2f5ea);
            color: #234e52;
            padding: 1.25rem;
            border-radius: 16px;
            margin-bottom: 1.5rem;
            border: 1px solid #81e6d9;
            text-align: center;
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .logout-link {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            margin-left: 0.5rem;
            transition: all 0.3s ease;
            padding: 0.25rem 0.5rem;
            border-radius: 8px;
        }

        .logout-link:hover {
            color: #764ba2;
            background: rgba(102, 126, 234, 0.1);
        }

        .form-group {
            margin-bottom: 1.75rem;
            position: relative;
        }

        label {
            display: block;
            margin-bottom: 0.75rem;
            color: #4a5568;
            font-weight: 600;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }

        .input-container {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            font-size: 1.1rem;
            transition: color 0.3s ease;
            z-index: 1;
        }

        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 1.25rem 1.25rem 1.25rem 3rem;
            border: 2px solid #e2e8f0;
            border-radius: 16px;
            font-size: 1rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: #f8fafc;
            color: #2d3748;
            position: relative;
        }

        input[type="email"]:focus,
        input[type="password"]:focus {
            outline: none;
            border-color: #667eea;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
            transform: translateY(-3px);
        }

        input[type="email"]:focus + .input-icon,
        input[type="password"]:focus + .input-icon {
            color: #667eea;
        }

        input[type="email"]:focus ~ label,
        input[type="password"]:focus ~ label {
            color: #667eea;
        }

        .password-toggle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #a0aec0;
            cursor: pointer;
            font-size: 1.1rem;
            transition: color 0.3s ease;
            z-index: 2;
        }

        .password-toggle:hover {
            color: #667eea;
        }

        .submit-btn {
            width: 100%;
            padding: 1.25rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 16px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            margin-bottom: 1rem;
        }

        .submit-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.6s ease;
        }

        .submit-btn:hover::before {
            left: 100%;
        }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(102, 126, 234, 0.4);
        }

        .submit-btn:active {
            transform: translateY(-1px);
        }

        .submit-btn.loading {
            background: linear-gradient(135deg, #a0aec0, #cbd5e0);
            cursor: not-allowed;
            transform: none;
        }

        .submit-btn.loading::after {
            content: '';
            position: absolute;
            width: 24px;
            height: 24px;
            border: 3px solid #ffffff;
            border-top: 3px solid transparent;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
        }

        @keyframes spin {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }

        .remember-me {
            display: flex;
            align-items: center;
            margin-bottom: 1.5rem;
            gap: 0.75rem;
        }

        .remember-me input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: #667eea;
            cursor: pointer;
        }

        .remember-me label {
            margin: 0;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .links {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1.5rem;
            gap: 1rem;
        }

        .links a {
            color: #667eea;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.3s ease;
            padding: 0.5rem;
            border-radius: 8px;
        }

        .links a:hover {
            color: #764ba2;
            background: rgba(102, 126, 234, 0.1);
        }

        .divider {
            display: flex;
            align-items: center;
            margin: 2rem 0;
            color: #a0aec0;
            font-size: 0.9rem;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(to right, transparent, #e2e8f0, transparent);
        }

        .divider span {
            padding: 0 1rem;
            background: rgba(255, 255, 255, 0.9);
        }

        .social-login {
            display: flex;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .social-btn {
            flex: 1;
            padding: 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            background: #ffffff;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-weight: 500;
            text-decoration: none;
            color: #4a5568;
        }

        .social-btn:hover {
            border-color: #667eea;
            background: #f8fafc;
            transform: translateY(-2px);
        }

        /* Responsive design */
        @media (max-width: 480px) {
            .login-container {
                padding: 2rem 1.5rem;
                margin: 1rem;
                border-radius: 20px;
            }

            .header h1 {
                font-size: 1.9rem;
            }

            .links {
                flex-direction: column;
                gap: 0.5rem;
            }

            .social-login {
                flex-direction: column;
            }
        }

        /* Dark mode support */
        @media (prefers-color-scheme: dark) {
            .login-container {
                background: rgba(26, 32, 44, 0.95);
                color: #e2e8f0;
            }

            input[type="email"],
            input[type="password"] {
                background: #2d3748;
                color: #e2e8f0;
                border-color: #4a5568;
            }

            input[type="email"]:focus,
            input[type="password"]:focus {
                background: #1a202c;
            }

            .social-btn {
                background: #2d3748;
                border-color: #4a5568;
                color: #e2e8f0;
            }

            .social-btn:hover {
                background: #4a5568;
            }
        }

        /* Form validation styles */
        .form-group.error input {
            border-color: #e53e3e;
            background: #fed7d7;
        }

        .form-group.success input {
            border-color: #38a169;
            background: #f0fff4;
        }

        .validation-message {
            font-size: 0.85rem;
            margin-top: 0.5rem;
            padding: 0.25rem 0;
        }

        .validation-message.error {
            color: #e53e3e;
        }

        .validation-message.success {
            color: #38a169;
        }
    </style>
</head>
<body>
    <div class="bg-shape"></div>
    <div class="bg-shape"></div>
    <div class="bg-shape"></div>

    <div class="login-container">
        <div class="header">
            <h1>Connexion</h1>
            
        </div>

        <!-- Messages -->
        <div class="alert" style="display: none;" id="error-message">
            <span id="error-text">Identifiants invalides</span>
        </div>

        <div class="success-alert alert" style="display: none;" id="success-message">
            <span id="success-text">Connexion réussie !</span>
        </div>

        <div class="user-info" style="display: none;" id="user-info">
            Vous êtes connecté en tant que <strong id="user-email">user@example.com</strong>
            <a href="#" class="logout-link" onclick="logout()">Se déconnecter</a>
        </div>

        <form id="login-form" action="{{ path('app_login') }}" method="post" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('authenticate') }}">
            <div class="form-group" id="email-group">
                <label for="email">Adresse email</label>
                <div class="input-container">
                    <input type="email" id="email" name="username" required>
                    <span class="input-icon">📧</span>
                </div>
                <div class="validation-message" id="email-validation"></div>
            </div>

            <div class="form-group" id="password-group">
                <label for="password">Mot de passe</label>
                <div class="input-container">
                    <input type="password" id="password" name="password" required>
                    <span class="input-icon"></span>
                    <button type="button" class="password-toggle" onclick="togglePassword()">👁️</button>
                </div>
                <div class="validation-message" id="password-validation"></div>
            </div>

            <div class="remember-me">
                <input type="checkbox" id="remember" name="remember">
                <label for="remember">Se souvenir de moi</label>
            </div>

            <button type="submit" class="submit-btn" id="submit-btn">
                Se connecter
            </button>
        </form>

        <div class="links">
            <a href="#" onclick="showForgotPassword()">Mot de passe oublié ?</a>
            <a href="#" onclick="showRegister()">Créer un compte</a>
        </div>

        
    </div>

    <script>
        // Variables globales
        let isLoading = false;
        let currentUser = null;

        // Animation des inputs
        const inputs = document.querySelectorAll('input[type="email"], input[type="password"]');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.closest('.form-group').style.transform = 'scale(1.02)';
                this.closest('.form-group').style.transition = 'transform 0.3s ease';
            });
            
            input.addEventListener('blur', function() {
                this.closest('.form-group').style.transform = 'scale(1)';
                validateField(this);
            });

            input.addEventListener('input', function() {
                clearValidation(this);
            });
        });

        // Validation en temps réel
        function validateField(input) {
            const formGroup = input.closest('.form-group');
            const validationMessage = formGroup.querySelector('.validation-message');
            
            if (input.type === 'email') {
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!input.value) {
                    showFieldError(formGroup, validationMessage, 'L\'email est requis');
                } else if (!emailRegex.test(input.value)) {
                    showFieldError(formGroup, validationMessage, 'Format d\'email invalide');
                } else {
                    showFieldSuccess(formGroup, validationMessage, 'Email valide');
                }
            } else if (input.type === 'password') {
                if (!input.value) {
                    showFieldError(formGroup, validationMessage, 'Le mot de passe est requis');
                } else if (input.value.length < 6) {
                    showFieldError(formGroup, validationMessage, 'Minimum 6 caractères');
                } else {
                    showFieldSuccess(formGroup, validationMessage, 'Mot de passe valide');
                }
            }
        }

        function showFieldError(formGroup, validationMessage, message) {
            formGroup.classList.remove('success');
            formGroup.classList.add('error');
            validationMessage.textContent = message;
            validationMessage.classList.remove('success');
            validationMessage.classList.add('error');
        }

        function showFieldSuccess(formGroup, validationMessage, message) {
            formGroup.classList.remove('error');
            formGroup.classList.add('success');
            validationMessage.textContent = message;
            validationMessage.classList.remove('error');
            validationMessage.classList.add('success');
        }

        function clearValidation(input) {
            const formGroup = input.closest('.form-group');
            const validationMessage = formGroup.querySelector('.validation-message');
            formGroup.classList.remove('error', 'success');
            validationMessage.textContent = '';
            validationMessage.classList.remove('error', 'success');
        }

        // Toggle password visibility
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleBtn = document.querySelector('.password-toggle');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleBtn.textContent = '🙈';
            } else {
                passwordInput.type = 'password';
                toggleBtn.textContent = '👁️';
            }
        }

        // Gestion du formulaire
        document.getElementById('login-form').addEventListener('submit', function(e) {
            if (isLoading) {
                e.preventDefault();
                return;
            }

            // Validation avant soumission
            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            
            validateField(emailInput);
            validateField(passwordInput);

            const hasErrors = document.querySelectorAll('.form-group.error').length > 0;
            
            if (hasErrors || !emailInput.value || !passwordInput.value) {
                e.preventDefault();
                showAlert('Veuillez corriger les erreurs avant de continuer', 'error');
                return;
            }

            // Simulation de chargement (à enlever en production)
            e.preventDefault();
            simulateLogin();
        });

        // Simulation de connexion (à remplacer par votre logique)
        function simulateLogin() {
            setLoading(true);
            
            setTimeout(() => {
                const email = document.getElementById('email').value;
                const password = document.getElementById('password').value;
                
                // Simulation - remplacez par votre logique d'authentification
                if (email && password) {
                    showLoginSuccess(email);
                } else {
                    showAlert('Identifiants invalides', 'error');
                }
                
                setLoading(false);
            }, 2000);
        }

        function setLoading(loading) {
            isLoading = loading;
            const submitBtn = document.getElementById('submit-btn');
            
            if (loading) {
                submitBtn.classList.add('loading');
                submitBtn.textContent = '';
            } else {
                submitBtn.classList.remove('loading');
                submitBtn.textContent = 'Se connecter';
            }
        }

        function showAlert(message, type = 'error') {
            const errorAlert = document.getElementById('error-message');
            const successAlert = document.getElementById('success-message');
            
            // Masquer tous les alerts
            errorAlert.style.display = 'none';
            successAlert.style.display = 'none';
            
            if (type === 'error') {
                document.getElementById('error-text').textContent = message;
                errorAlert.style.display = 'block';
            } else {
                document.getElementById('success-text').textContent = message;
                successAlert.style.display = 'block';
            }
        }

        function showLoginSuccess(email) {
            currentUser = email;
            document.getElementById('user-email').textContent = email;
            document.getElementById('user-info').style.display = 'block';
            document.getElementById('login-form').style.display = 'none';
            showAlert('Connexion réussie ! Redirection en cours...', 'success');
            
            // Simulation de redirection
            setTimeout(() => {
                // window.location.href = '/dashboard';
                console.log('Redirection vers le dashboard...');
            }, 2000);
        }

        function logout() {
            currentUser = null;
            document.getElementById('user-info').style.display = 'none';
            document.getElementById('login-form').style.display = 'block';
            document.getElementById('login-form').reset();
            
            // Nettoyer les validations
            document.querySelectorAll('.form-group').forEach(group => {
                group.classList.remove('error', 'success');
            });
            document.querySelectorAll('.validation-message').forEach(msg => {
                msg.textContent = '';
                msg.classList.remove('error', 'success');
            });
            
            showAlert('Déconnexion réussie', 'success');
            setTimeout(() => {
                document.getElementById('success-message').style.display = 'none';
            }, 3000);
        }

        // Fonctions pour les liens (à personnaliser)
        function showForgotPassword() {
            alert('Fonctionnalité "Mot de passe oublié" - À implémenter');
        }

        function showRegister() {
            alert('Fonctionnalité "Créer un compte" - À implémenter');
        }

        function socialLogin(provider) {
            alert(`Connexion via ${provider} - À implémenter`);
        }

        // Effet de parallaxe léger pour les formes d'arrière-plan
        document.addEventListener('mousemove', function(e) {
            const shapes = document.querySelectorAll('.bg-shape');
            const x = e.clientX / window.innerWidth;
            const y = e.clientY / window.innerHeight;
            
            shapes.forEach((shape, index) => {
                const speed = (index + 1) * 0.5;
                const xMove = (x - 0.5) * speed * 10;
                const yMove = (y - 0.5) * speed * 10;
                
                shape.style.transform = `translate(${xMove}px, ${yMove}px)`;
            });
        });

        // Animation d'apparition progressive des éléments
        window.addEventListener('load', function() {
            const elements = document.querySelectorAll('.form-group, .links, .social-login');
            elements.forEach((el, index) => {
                setTimeout(() => {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(20px)';
                    el.style.transition = 'all 0.6s ease';
                    
                    setTimeout(() => {
                        el.style.opacity = '1';
                        el.style.transform = 'translateY(0)';
                    }, 100);
                }, index * 100);
            });
        });
    </script>
</body>
</html>