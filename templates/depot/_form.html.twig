{{ form_start(form, { attr: { id: 'depot-form', style: 'display:flex;flex-direction:column;gap:12px;min-width:360px;max-width:560px;' } }) }}
    {{ form_errors(form) }}

    {{ form_row(form.nom, {
        attr: {
            placeholder: "Saisissez le nom du dépôt",
            style: 'width:100%;box-sizing:border-box;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;outline:none;'
        }
    }) }}

    {{ form_row(form.adresse, {
        attr: {
            placeholder: "Saisissez l\'adresse",
            style: 'width:100%;box-sizing:border-box;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;outline:none;'
        }
    }) }}

    {# If societe is disabled (locked), render as subtle disabled field; else normal row #}
    {% if form.societe is defined %}
        {% if form.societe.vars.disabled %}
            <div style="opacity:.8;">
                {{ form_row(form.societe, {
                    attr: {
                        style: 'width:100%;box-sizing:border-box;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#f1f5f9;cursor:not-allowed;'
                    }
                }) }}
            </div>
        {% else %}
            {{ form_row(form.societe, {
                attr: {
                    style: 'width:100%;box-sizing:border-box;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;'
                }
            }) }}
        {% endif %}
    {% endif %}

    <div style="display:flex;justify-content:flex-end;margin-top:6px;">
        <button type="submit" style="display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border:none;border-radius:10px;background:#22c55e;color:white;font-weight:600;box-shadow:0 6px 14px rgba(34,197,94,.25);cursor:pointer;">
            <span>✅</span>
            <span>{{ (button_label|default('depot.form.save'))|trans(domain='depot') }}</span>
        </button>
    </div>
{{ form_end(form) }}
