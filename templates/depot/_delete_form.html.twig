<form method="post" action="{{ path('app_depot_delete', {'id': depot.id}) }}" onsubmit="return confirm('{{ 'depot.index.confirm_delete'|trans([], 'depot') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depot.id) }}">
    <button class="btn">{{ 'depot.actions.delete'|trans([], 'depot') }}</button>
</form>
