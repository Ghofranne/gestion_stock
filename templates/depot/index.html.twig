{% extends 'base.html.twig' %}

{% block title %}{{ 'depot.index.title'|trans([], 'depot') }}{% endblock %}

{% block body %}
    <div class="list-container">
        <div class="depot-search">
            <input type="text" id="depotSearch" class="search-input" placeholder="Rechercher...">
            <span class="search-icon">🔍</span>
        </div>
        <h2 class="list-title">{{ 'depot.index.heading'|trans([], 'depot') }}</h2>
        <div class="table-card">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>{{ 'depot.index.name'|trans([], 'depot') }}</th>
                        <th>{{ 'depot.index.address'|trans([], 'depot') }}</th>
                        <th>{{ 'depot.index.company'|trans([], 'depot') }}</th>
                        <th>{{ 'depot.index.actions'|trans([], 'depot') }}</th>
                    </tr>
                </thead>
                <tbody id="depotTbody">
                {% for depot in depots %}
                    <tr>
                        <td>{{ depot.nom }}</td>
                        <td>{{ depot.adresse }}</td>
                        <td>
                            {% if depot.societe %}
                                <span class="societe-badge">{{ depot.societe.nom }}</span>
                            {% else %}
                                <em class="no-societe">{{ 'depot.index.no_company'|trans([], 'depot') }}</em>
                            {% endif %}
                        </td>
                        <td>
                            <div class="action-icons">
                                <a href="{{ path('app_depot_show', {'id': depot.id}) }}" class="icon-btn" title="{{ 'depot.actions.view'|trans([], 'depot') }}">
                                    👁️<span class="sr-only">{{ 'depot.actions.view'|trans([], 'depot') }}</span>
                                </a>
                                <a href="{{ path('app_depot_edit', {'id': depot.id}) }}" class="icon-btn" title="{{ 'depot.actions.edit'|trans([], 'depot') }}">
                                    ✏️<span class="sr-only">{{ 'depot.actions.edit'|trans([], 'depot') }}</span>
                                </a>
                                <form method="post" action="{{ path('app_depot_delete', {'id': depot.id}) }}" class="inline-form" onsubmit="return confirm('{{ 'depot.index.confirm_delete'|trans([], 'depot') }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depot.id) }}">
                                    <button class="icon-btn icon-danger" title="{{ 'depot.actions.delete'|trans([], 'depot') }}">🗑️<span class="sr-only">{{ 'depot.actions.delete'|trans([], 'depot') }}</span></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">{{ 'depot.index.none'|trans([], 'depot') }}</td>
                    </tr>
                {% endfor %}
                <!-- Empty state for search filtering -->
                <tr id="depotEmptyRow" style="display:none;">
                    <td colspan="4" style="text-align:center;color:#6b7280;">Aucun dépôt trouvé</td>
                </tr>
                </tbody>
            </table>
        </div>
        <a href="{{ path('app_depot_new') }}" class="btn-create">+ {{ 'depot.index.add'|trans([], 'depot') }}</a>
    </div>
    <style>
        .depot-search { position: relative; max-width: 360px; margin: .25rem 0 1rem auto; }
        .depot-search .search-input { width:100%; padding:.45rem .75rem .45rem 2rem; border:1px solid rgba(0,0,0,.15); border-radius:999px; outline:none; box-shadow: inset 0 1px 2px rgba(0,0,0,.04); }
        .depot-search .search-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); pointer-events:none; opacity:.85; color:#764ba2; }
        .list-container {
            max-width: 800px;
            margin: 3rem auto 0 auto;
            padding: 2.5rem 1.5rem;
            background: rgba(255,255,255,0.96);
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(102, 126, 234, 0.13);
        }
        .list-title {
            color: #764ba2;
            font-size: 1.7rem;
            margin-bottom: 2rem;
            letter-spacing: 0.5px;
            text-align: center;
        }
        .table-card {
            overflow-x: auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(102, 126, 234, 0.07);
            margin-bottom: 2rem;
        }
        .modern-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1.02rem;
            background: transparent;
        }
        .modern-table th, .modern-table td {
            padding: 0.8rem 0.7rem;
            text-align: left;
        }
        .modern-table th {
            background: #f6f7fb;
            color: #764ba2;
            font-weight: 700;
            border-bottom: 2px solid #e2e8f0;
        }
        .modern-table tr {
            border-bottom: 1px solid #e2e8f0;
            transition: background 0.18s;
        }
        .modern-table tr:hover {
            background: #f3eaff;
        }
        .modern-table td {
            color: #222;
        }
        .action-icons { display: flex; gap: .35rem; align-items: center; }
        .inline-form { display: inline; margin: 0; padding: 0; }
        .icon-btn { 
            display: inline-flex; align-items: center; justify-content: center;
            width: 34px; height: 34px; border-radius: 8px; border: none; cursor: pointer;
            background: #eef2ff; color: #4c51bf; text-decoration: none; font-size: 18px;
            box-shadow: 0 1px 4px rgba(102,126,234,.15);
            transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
        }
        .icon-btn:hover { background: #e0e7ff; transform: translateY(-1px); box-shadow: 0 3px 10px rgba(102,126,234,.25); }
        .icon-danger { background: #fee2e2; color: #b91c1c; }
        .icon-danger:hover { background: #fecaca; }
        .sr-only { position: absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
        .btn-create {
            display: inline-block;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.7rem 1.7rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            text-decoration: none;
            box-shadow: 0 2px 10px rgba(102, 126, 234, 0.13);
            transition: background 0.2s;
            margin-top: 0.8rem;
        }
        .btn-create:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        
        .societe-badge {
            display: inline-block;
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            padding: 0.3rem 0.8rem;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .no-societe {
            color: #9ca3af;
            font-style: italic;
            font-size: 0.9rem;
        }
        @media (max-width: 700px) {
            .list-container {
                padding: 0.7rem 0.2rem;
            }
            .modern-table th, .modern-table td {
                padding: 0.55rem 0.3rem;
                font-size: 0.98rem;
            }
        }
    </style>
    <script>
        (function(){
            const input = document.getElementById('depotSearch');
            const tbody = document.getElementById('depotTbody');
            const rows = () => Array.from(tbody.querySelectorAll('tr'));
            const emptyRow = document.getElementById('depotEmptyRow');
            if(!input || !tbody) return;
            let timer;
            const filter = () => {
                const q = input.value.trim().toLowerCase();
                let visible = 0;
                rows().forEach(tr => {
                    if(tr === emptyRow) return; // skip empty row
                    const text = tr.textContent.toLowerCase();
                    const show = q === '' || text.includes(q);
                    tr.style.display = show ? '' : 'none';
                    if(show) visible++;
                });
                if(emptyRow){ emptyRow.style.display = visible === 0 ? '' : 'none'; }
            };
            input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(filter, 160); });
        })();
    </script>
{% endblock %}
