{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe - StockPro{% endblock %}

{% block stylesheets %}
<style>
.form-card { max-width: 700px; margin: 0 auto; background: rgba(255,255,255,.95); backdrop-filter: blur(10px); border-radius: 16px; padding: 2rem; box-shadow: 0 8px 32px rgba(0,0,0,.1); }
.form-row { margin-bottom: 1rem; }
.form-label { display:block; font-weight:600; color:#4a5568; margin-bottom:.5rem; }
.form-input { width:100%; padding:.75rem 1rem; border:1px solid #e2e8f0; border-radius:10px; outline:none; transition: box-shadow .2s ease, border-color .2s ease; }
.form-input:focus { border-color:#667eea; box-shadow:0 0 0 3px rgba(102,126,234,.2); }
.help { color:#718096; font-size:.9rem; margin-top:.25rem; }
.form-actions { display:flex; gap:.75rem; }
.btn { display:inline-block; padding:.75rem 1.25rem; border-radius:10px; text-decoration:none; font-weight:600; border:none; cursor:pointer; }
.btn-primary { background: linear-gradient(135deg,#667eea,#764ba2); color:#fff; }
.btn-secondary { background:#e2e8f0; color:#2d3748; }
.btn:hover { transform: translateY(-1px); box-shadow: 0 8px 25px rgba(102,126,234,.2); }
.error { color:#c53030; margin-bottom:1rem; }
</style>
{% endblock %}

{% block body %}
<div class="form-card">
  <h1 style="margin-bottom:1rem; color:#2d3748;">Changer mon mot de passe</h1>
  {% if error %}
    <div class="error">{{ error }}</div>
  {% endif %}
  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="flash-{{ label }}">{{ message }}</div>
    {% endfor %}
  {% endfor %}
  <form method="post">
    <div class="form-row">
      <label class="form-label" for="current_password">Mot de passe actuel</label>
      <input id="current_password" name="current_password" type="password" required class="form-input">
    </div>
    <div class="form-row">
      <label class="form-label" for="new_password">Nouveau mot de passe</label>
      <input id="new_password" name="new_password" type="password" required minlength="8" class="form-input">
      <div class="help">8 caractères minimum, mélangez lettres, chiffres et symboles.</div>
    </div>
    <div class="form-row">
      <label class="form-label" for="confirm_password">Confirmer le nouveau mot de passe</label>
      <input id="confirm_password" name="confirm_password" type="password" required class="form-input">
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Mettre à jour</button>
      <a class="btn btn-secondary" href="{{ path('app_profil') }}">Annuler</a>
    </div>
  </form>
</div>
{% endblock %}
