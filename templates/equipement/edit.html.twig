{% extends 'base.html.twig' %}

{% block title %}{{ 'equipement.edit.title'|trans([], 'equipement') }}{% endblock %}

{% block body %}
    <div class="form-container">
        <h2 class="form-title">{{ 'equipement.edit.heading'|trans([], 'equipement') }}</h2>
        <div class="form-card">
            {{ include('equipement/_form.html.twig', {'button_label': ('equipement.edit.update'|trans([], 'equipement'))}) }}
        </div>
        <a href="{{ path('app_equipement_index') }}" class="btn-back">&#8592; {{ 'equipement.edit.back'|trans([], 'equipement') }}</a>
        <div style="margin-top:1.5rem;">{{ include('equipement/_delete_form.html.twig') }}</div>
    </div>
    <style>
        .form-container {
            max-width: 420px;
            margin: 3rem auto 0 auto;
            padding: 2rem 1.5rem;
            background: rgba(255,255,255,0.97);
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(102, 126, 234, 0.13);
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .form-title {
            color: #764ba2;
            font-size: 1.6rem;
            margin-bottom: 1.5rem;
            letter-spacing: 0.5px;
        }
        .form-card {
            width: 100%;
        }
        form {
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
            align-items: center;
        }
        form label {
            font-weight: 600;
            color: #333;
            margin-bottom: 0.4rem;
            align-self: flex-start;
            font-size: 1.08rem;
        }
        form input[type="text"],
        form input[type="email"],
        form input[type="number"],
        form input,
        form textarea {
            width: 100%;
            max-width: 320px;
            min-width: 220px;
            box-sizing: border-box;
            padding: 0.9rem 1.2rem;
            border-radius: 10px;
            border: 1.5px solid #d1d5db;
            background: #f6f7fb;
            font-size: 1.08rem;
            margin-bottom: 0.2rem;
            transition: border-color 0.2s, box-shadow 0.2s;
            box-shadow: 0 1px 4px rgba(102, 126, 234, 0.06);
        }
        form input:focus, form textarea:focus {
            border-color: #764ba2;
            outline: none;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.17);
        }
        .btn {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.6rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            margin-top: 0.8rem;
            transition: background 0.2s;
        }
        .btn:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        .btn-back {
            display: inline-block;
            margin-top: 1.6rem;
            color: #764ba2;
            background: none;
            border: none;
            font-weight: 600;
            text-decoration: none;
            font-size: 1rem;
            transition: color 0.2s;
        }
        .btn-back:hover {
            color: #667eea;
            text-decoration: underline;
        }
    </style>
{% endblock %}
