<form method="post" action="{{ path('app_equipement_delete', {'id': equipement.id}) }}" onsubmit="return confirm('{{ 'equipement.index.confirm_delete'|trans([], 'equipement') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipement.id) }}">
    <button class="btn">{{ 'equipement.actions.delete'|trans([], 'equipement') }}</button>
</form>
