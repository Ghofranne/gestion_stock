{% extends 'base.html.twig' %}
{% set embedded = app.request.get('embedded') %}

{% block title %}{{ 'equipement.new.title'|trans([], 'equipement') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .js-dynamic-field { display: none !important; }
        .js-dynamic-field[style*="display: block"] { display: block !important; }
        /* Mode embarqué: masquer l'en-tête/nav/footer globaux et adapter le fond */
        .is-embedded { box-shadow: none; border-radius: 12px; margin: 0.5rem auto; }
        {% if embedded %}
        body { background: transparent !important; }
        header, nav, .navbar, .site-header, .app-header, footer { display: none !important; }
        .form-container { background: #fff; }
        {% endif %}
    </style>
{% endblock %}

{% block body %}
    <div class="form-container {{ embedded ? 'is-embedded' : '' }}">
        <div class="modal-like-header">
            <div class="title-left">
                <span class="icon" aria-hidden="true">🧩</span>
                <span class="title-text">Ajouter un équipement</span>
            </div>
        </div>
        <div class="form-card">
            {{ include('equipement/_form.html.twig') }}
        </div>
        {% if not embedded %}
            <a href="{{ path('app_equipement_index') }}" class="btn-back">&#8592; {{ 'equipement.new.back'|trans([], 'equipement') }}</a>
        {% endif %}
    </div>
    <style>
        .form-container {
            max-width: 420px;
            margin: 3rem auto 0 auto;
            padding: 2rem 1.5rem;
            background: rgba(255,255,255,0.97);
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(102, 126, 234, 0.13);
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .modal-like-header { width:100%; display:flex; align-items:center; justify-content: space-between; border-bottom:1px solid #eee; padding-bottom:0.8rem; margin-bottom:1rem; }
        .modal-like-header .title-left { display:flex; align-items:center; gap:10px; font-weight:700; font-size:1.2rem; color:#2d3748; }
        .modal-like-header .icon { font-size:1.4rem; }
        .form-title {
            color: #764ba2;
            font-size: 1.6rem;
            margin-bottom: 1.5rem;
            letter-spacing: 0.5px;
        }
        .form-card {
            width: 100%;
        }
        form {
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
            align-items: center;
        }
        form label {
            font-weight: 600;
            color: #333;
            margin-bottom: 0.4rem;
            align-self: flex-start;
            font-size: 1.08rem;
        }
        form input[type="text"],
        form input[type="email"],
        form input[type="number"],
        form input,
        form textarea {
            width: 100%;
            max-width: 320px;
            min-width: 220px;
            box-sizing: border-box;
            padding: 0.9rem 1.2rem;
            border-radius: 10px;
            border: 1.5px solid #d1d5db;
            background: #f6f7fb;
            font-size: 1.08rem;
            margin-bottom: 0.2rem;
            transition: border-color 0.2s, box-shadow 0.2s;
            box-shadow: 0 1px 4px rgba(102, 126, 234, 0.06);
        }
        form input:focus, form textarea:focus {
            border-color: #764ba2;
            outline: none;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.17);
        }
        .btn {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.6rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            margin-top: 0.8rem;
            transition: background 0.2s;
        }
        .btn:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        .btn-back {
            display: inline-block;
            margin-top: 1.6rem;
            color: #764ba2;
            background: none;
            border: none;
            font-weight: 600;
            text-decoration: none;
            font-size: 1rem;
            transition: color 0.2s;
        }
        .btn-back:hover {
            color: #667eea;
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function updateFields() {
            var typeSelect = document.getElementById('equipement_typeEquipement');
            if (!typeSelect) return;
            var type = typeSelect.value;
            document.querySelectorAll('.js-dynamic-field').forEach(function(div) {
                div.style.display = 'none';
            });
            if (type === 'SIM') {
                document.querySelectorAll('.js-sim-field').forEach(function(div) {
                    div.style.display = 'block';
                });
            }
            if (type === 'TPE') {
                document.querySelectorAll('.js-tpe-field').forEach(function(div) {
                    div.style.display = 'block';
                });
            }
            if (type === 'Carte') {
                document.querySelectorAll('.js-carte-field').forEach(function(div) {
                    div.style.display = 'block';
                });
            }
            // Debug
            console.log('Type sélectionné :', type);
        }
        document.addEventListener('DOMContentLoaded', function() {
            var typeSelect = document.getElementById('equipement_typeEquipement');
            if (typeSelect) {
                typeSelect.addEventListener('change', updateFields);
                updateFields();
            }
        });
    </script>
{% endblock %}
