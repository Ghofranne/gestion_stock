{% extends 'base.html.twig' %}

{% block title %}{{ 'equipement.index.title'|trans([], 'equipement') }}{% endblock %}

{% block body %}
    <div class="list-container">
        <div class="equip-search">
            <input type="text" id="equipSearch" class="search-input" placeholder="Rechercher...">
            <span class="search-icon">🔍</span>
        </div>
        <h2 class="list-title">{{ 'equipement.index.heading'|trans([], 'equipement') }}</h2>
        <div class="cards-wrapper">
            {% for equipement in equipements %}
                <div class="equip-card">
                    <div class="equip-type">{{ equipement.typeEquipement }}</div>
                    <div class="equip-attrs">
                        {% if equipement.typeEquipement == 'SIM' %}
                            <div><span class="attr-label">{{ 'equipement.labels.imei'|trans([], 'equipement') }}</span> {{ equipement.imei }}</div>
                            <div><span class="attr-label">{{ 'equipement.labels.num_call'|trans([], 'equipement') }}</span> {{ equipement.numAppel }}</div>
                            <div><span class="attr-label">{{ 'equipement.labels.operator'|trans([], 'equipement') }}</span> {{ equipement.operateur }}</div>
                            {% set etat = statusById[equipement.id]|default(equipement.etat) %}
                            <div>
                                <span class="attr-label">{{ 'equipement.labels.state'|trans([], 'equipement') }}</span>
                                <span class="state-badge 
                                    {{ etat == 'Disponible' ? 'state-success' : 
                                       (etat in ['Affecté', 'Affecte'] ? 'state-info' : 
                                       (etat == 'Non disponible' ? 'state-danger' : 
                                       (etat == 'Retour' ? 'state-warning' : 'state-neutral'))) }}">
                                    {{ etat }}
                                </span>
                            </div>
                        {% elseif equipement.typeEquipement == 'TPE' %}
                            <div><span class="attr-label">{{ 'equipement.labels.sn'|trans([], 'equipement') }}</span> {{ equipement.sn }}</div>
                            <div><span class="attr-label">{{ 'equipement.labels.model'|trans([], 'equipement') }}</span> {{ equipement.model }}</div>
                            <div><span class="attr-label">{{ 'equipement.labels.supplier'|trans([], 'equipement') }}</span> {{ equipement.fournisseur }}</div>
                            {% set etat = statusById[equipement.id]|default(equipement.etat) %}
                            <div>
                                <span class="attr-label">{{ 'equipement.labels.state'|trans([], 'equipement') }}</span>
                                <span class="state-badge 
                                    {{ etat == 'Disponible' ? 'state-success' : 
                                       (etat in ['Affecté', 'Affecte'] ? 'state-info' : 
                                       (etat == 'Non disponible' ? 'state-danger' : 
                                       (etat == 'Retour' ? 'state-warning' : 'state-neutral'))) }}">
                                    {{ etat }}
                                </span>
                            </div>
                        {% elseif equipement.typeEquipement == 'Carte' %}
                            <div><span class="attr-label">{{ 'equipement.labels.card_ref'|trans([], 'equipement') }}</span> {{ equipement.referenceCarte }}</div>
                            {% set etat = statusById[equipement.id]|default(equipement.etat) %}
                            <div>
                                <span class="attr-label">{{ 'equipement.labels.state'|trans([], 'equipement') }}</span>
                                <span class="state-badge 
                                    {{ etat == 'Disponible' ? 'state-success' : 
                                       (etat in ['Affecté', 'Affecte'] ? 'state-info' : 
                                       (etat == 'Non disponible' ? 'state-danger' : 
                                       (etat == 'Retour' ? 'state-warning' : 'state-neutral'))) }}">
                                    {{ etat }}
                                </span>
                            </div>
                        {% elseif equipement.typeEquipement == 'Autres' %}
                            {% if equipement.fournisseur %}
                                <div><span class="attr-label">{{ 'equipement.labels.supplier'|trans([], 'equipement') }}</span> {{ equipement.fournisseur }}</div>
                            {% endif %}
                            {% if equipement.description %}
                                <div><span class="attr-label">{{ 'equipement.form.description'|trans([], 'equipement') }}</span> {{ equipement.description }}</div>
                            {% endif %}
                            {% set etat = statusById[equipement.id]|default(equipement.etat) %}
                            <div>
                                <span class="attr-label">{{ 'equipement.labels.state'|trans([], 'equipement') }}</span>
                                <span class="state-badge 
                                    {{ etat == 'Disponible' ? 'state-success' : 
                                       (etat in ['Affecté', 'Affecte'] ? 'state-info' : 
                                       (etat == 'Non disponible' ? 'state-danger' : 
                                       (etat == 'Retour' ? 'state-warning' : 'state-neutral'))) }}">
                                    {{ etat }}
                                </span>
                            </div>
                        {% else %}
                            {# Sécurité: afficher toute info disponible par défaut pour autres cas imprévus #}
                            {% if equipement.fournisseur %}
                                <div><span class="attr-label">{{ 'equipement.labels.supplier'|trans([], 'equipement') }}</span> {{ equipement.fournisseur }}</div>
                            {% endif %}
                            {% if equipement.description %}
                                <div><span class="attr-label">{{ 'equipement.form.description'|trans([], 'equipement') }}</span> {{ equipement.description }}</div>
                            {% endif %}
                            {% set etatCourant = statusById[equipement.id]|default(equipement.etat) %}
                            {% if etatCourant %}
                                <div>
                                    <span class="attr-label">{{ 'equipement.labels.state'|trans([], 'equipement') }}</span>
                                    <span class="state-badge 
                                        {{ etatCourant == 'Disponible' ? 'state-success' : 
                                           (etatCourant in ['Affecté', 'Affecte'] ? 'state-info' : 
                                           (etatCourant == 'Non disponible' ? 'state-danger' : 
                                           (etatCourant == 'Retour' ? 'state-warning' : 'state-neutral'))) }}">
                                        {{ etatCourant }}
                                    </span>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                    <div class="equip-actions">
                        <a href="{{ path('app_equipement_edit', {'id': equipement.id}) }}" class="btn-action">{{ 'equipement.actions.edit'|trans([], 'equipement') }}</a>
                        <form method="post" action="{{ path('app_equipement_delete', {'id': equipement.id}) }}" style="display: inline;" onsubmit="return confirm('{{ 'equipement.index.confirm_delete'|trans([], 'equipement') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipement.id) }}">
                            <button type="submit" class="btn-action btn-delete">{{ 'equipement.actions.delete'|trans([], 'equipement') }}</button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div style="text-align:center;width:100%;color:#764ba2;font-weight:600;">{{ 'equipement.index.none'|trans([], 'equipement') }}</div>
            {% endfor %}
        </div>
        <div id="equipEmpty" style="display:none;text-align:center;width:100%;color:#6b7280;margin-top:1rem;">Aucun équipement trouvé</div>
        <a href="{{ path('app_equipement_new') }}" class="btn-create">+ {{ 'equipement.index.add'|trans([], 'equipement') }}</a>
    </div>
    <style>
        .equip-search { position: relative; max-width: 360px; margin: .25rem 0 1rem auto; }
        .equip-search .search-input { width:100%; padding:.45rem .75rem .45rem 2rem; border:1px solid rgba(0,0,0,.15); border-radius:999px; outline:none; box-shadow: inset 0 1px 2px rgba(0,0,0,.04); }
        .equip-search .search-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); pointer-events:none; opacity:.85; color:#764ba2; }
        .cards-wrapper {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            margin-bottom: 2.5rem;
            margin-top: 2.2rem;
        }
        .equip-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(102, 126, 234, 0.11);
            padding: 1.5rem 1.2rem 1.1rem 1.2rem;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            min-height: 210px;
            position: relative;
        }
        .equip-type {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border-radius: 8px;
            padding: 0.3rem 1.1rem;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 1.1rem;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.10);
        }
        .equip-attrs {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
            margin-bottom: 1.2rem;
        }
        .attr-label {
            color: #764ba2;
            font-weight: 600;
            margin-right: 0.45em;
        }
        .equip-actions {
            display: flex;
            gap: 1.1rem;
            margin-top: auto;
        }
        .btn-action {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.5rem 1.3rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.10);
            transition: background 0.2s;
        }
        .btn-action:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        .btn-delete {
            background: linear-gradient(135deg, #e74c3c, #c0392b) !important;
            border: none;
            cursor: pointer;
        }
        .btn-delete:hover {
            background: linear-gradient(135deg, #c0392b, #a93226) !important;
        }
        .equip-actions {
            display: flex;
            gap: 0.8rem;
            margin-top: auto;
            align-items: center;
        }
        @media (max-width: 700px) {
            .cards-wrapper {
                grid-template-columns: 1fr;
                gap: 1.1rem;
            }
        }
    </style>
    <script>
        (function(){
            const input = document.getElementById('equipSearch');
            const grid = document.querySelector('.cards-wrapper');
            const cards = () => Array.from(grid ? grid.querySelectorAll('.equip-card') : []);
            const emptyMsg = document.getElementById('equipEmpty');
            if(!input || !grid) return;
            let timer;
            const filter = () => {
                const q = input.value.trim().toLowerCase();
                let visible = 0;
                cards().forEach(card => {
                    const text = card.textContent.toLowerCase();
                    const show = q === '' || text.includes(q);
                    card.style.display = show ? '' : 'none';
                    if(show) visible++;
                });
                if(emptyMsg){ emptyMsg.style.display = visible === 0 ? '' : 'none'; }
            };
            input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(filter, 160); });
        })();
    </script>

    <style>
        .list-container {
            max-width: 1100px;
            margin: 3rem auto 0 auto;
            padding: 2.5rem 1.5rem;
            background: rgba(255,255,255,0.96);
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(102, 126, 234, 0.13);
        }
        .list-title {
            color: #764ba2;
            font-size: 1.7rem;
            margin-bottom: 2rem;
            letter-spacing: 0.5px;
            text-align: center;
        }
        .table-card {
            overflow-x: auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(102, 126, 234, 0.07);
            margin-bottom: 2rem;
        }
        .modern-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1.02rem;
            background: transparent;
        }
        .modern-table th, .modern-table td {
            padding: 0.8rem 0.7rem;
            text-align: left;
        }
        .modern-table th {
            background: #f6f7fb;
            color: #764ba2;
            font-weight: 700;
            border-bottom: 2px solid #e2e8f0;
        }
        .modern-table tr {
            border-bottom: 1px solid #e2e8f0;
            transition: background 0.18s;
        }
        .modern-table tr:hover {
            background: #f3eaff;
        }
        .modern-table td {
            color: #222;
        }
        .action-link {
            color: #667eea;
            margin-right: 0.7em;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.17s;
        }
        .action-link:hover {
            color: #764ba2;
            text-decoration: underline;
        }
        .btn-create {
            display: inline-block;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.7rem 1.7rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            text-decoration: none;
            box-shadow: 0 2px 10px rgba(102, 126, 234, 0.13);
            transition: background 0.2s;
            margin-top: 0.8rem;
        }
        .btn-create:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        /* Etat badges */
        .state-badge { display:inline-block; padding: 2px 10px; border-radius: 999px; font-weight: 700; font-size: .82rem; border: 1px solid transparent; }
        .state-success { background:#ecfdf5; color:#047857; border-color:#a7f3d0; }
        .state-info { background:#eef2ff; color:#3730a3; border-color:#c7d2fe; }
        .state-danger { background:#fef2f2; color:#b91c1c; border-color:#fecaca; }
        .state-warning { background:#fffbeb; color:#92400e; border-color:#fde68a; }
        .state-neutral { background:#f3f4f6; color:#374151; border-color:#e5e7eb; }
        @media (max-width: 700px) {
            .list-container {
                padding: 0.7rem 0.2rem;
            }
            .modern-table th, .modern-table td {
                padding: 0.55rem 0.3rem;
                font-size: 0.98rem;
            }
        }
    </style>
{% endblock %}
