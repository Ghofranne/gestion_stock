{% extends 'base.html.twig' %}

{% block title %}Equipement index{% endblock %}

{% block body %}
    <div class="list-container">
        <h2 class="list-title">Liste des équipements</h2>
        <div class="cards-wrapper">
            {% for equipement in equipements %}
                <div class="equip-card">
                    <div class="equip-type">{{ equipement.typeEquipement }}</div>
                    <div class="equip-attrs">
                        {% if equipement.typeEquipement == 'SIM' %}
                            <div><span class="attr-label">IMEI :</span> {{ equipement.imei }}</div>
                            <div><span class="attr-label">Num appel :</span> {{ equipement.numAppel }}</div>
                            <div><span class="attr-label">Opérateur :</span> {{ equipement.operateur }}</div>
                            
                            <div><span class="attr-label">État :</span> {{ equipement.etat }}</div>
                        {% elseif equipement.typeEquipement == 'TPE' %}
                            <div><span class="attr-label">SN :</span> {{ equipement.sn }}</div>
                            <div><span class="attr-label">Modèle :</span> {{ equipement.model }}</div>
                            <div><span class="attr-label">Fournisseur :</span> {{ equipement.fournisseur }}</div>
                            <div><span class="attr-label">État :</span> {{ equipement.etat }}</div>
                        {% elseif equipement.typeEquipement == 'Carte' %}
                            <div><span class="attr-label">Référence carte :</span> {{ equipement.referenceCarte }}</div>
                            
                            <div><span class="attr-label">État :</span> {{ equipement.etat }}</div>
                        {% endif %}
                    </div>
                    <div class="equip-actions">
                        <a href="{{ path('app_equipement_edit', {'id': equipement.id}) }}" class="btn-action">Modifier</a>
                        <form method="post" action="{{ path('app_equipement_delete', {'id': equipement.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet équipement ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipement.id) }}">
                            <button type="submit" class="btn-action btn-delete">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div style="text-align:center;width:100%;color:#764ba2;font-weight:600;">Aucun équipement trouvé</div>
            {% endfor %}
        </div>
        <a href="{{ path('app_equipement_new') }}" class="btn-create">+ Ajouter un équipement</a>
    </div>
    <style>
        .cards-wrapper {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            margin-bottom: 2.5rem;
            margin-top: 2.2rem;
        }
        .equip-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(102, 126, 234, 0.11);
            padding: 1.5rem 1.2rem 1.1rem 1.2rem;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            min-height: 210px;
            position: relative;
        }
        .equip-type {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border-radius: 8px;
            padding: 0.3rem 1.1rem;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 1.1rem;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.10);
        }
        .equip-attrs {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
            margin-bottom: 1.2rem;
        }
        .attr-label {
            color: #764ba2;
            font-weight: 600;
            margin-right: 0.45em;
        }
        .equip-actions {
            display: flex;
            gap: 1.1rem;
            margin-top: auto;
        }
        .btn-action {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.5rem 1.3rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.10);
            transition: background 0.2s;
        }
        .btn-action:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        .btn-delete {
            background: linear-gradient(135deg, #e74c3c, #c0392b) !important;
            border: none;
            cursor: pointer;
        }
        .btn-delete:hover {
            background: linear-gradient(135deg, #c0392b, #a93226) !important;
        }
        .equip-actions {
            display: flex;
            gap: 0.8rem;
            margin-top: auto;
            align-items: center;
        }
        @media (max-width: 700px) {
            .cards-wrapper {
                grid-template-columns: 1fr;
                gap: 1.1rem;
            }
        }
    </style>

    <style>
        .list-container {
            max-width: 1100px;
            margin: 3rem auto 0 auto;
            padding: 2.5rem 1.5rem;
            background: rgba(255,255,255,0.96);
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(102, 126, 234, 0.13);
        }
        .list-title {
            color: #764ba2;
            font-size: 1.7rem;
            margin-bottom: 2rem;
            letter-spacing: 0.5px;
            text-align: center;
        }
        .table-card {
            overflow-x: auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(102, 126, 234, 0.07);
            margin-bottom: 2rem;
        }
        .modern-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1.02rem;
            background: transparent;
        }
        .modern-table th, .modern-table td {
            padding: 0.8rem 0.7rem;
            text-align: left;
        }
        .modern-table th {
            background: #f6f7fb;
            color: #764ba2;
            font-weight: 700;
            border-bottom: 2px solid #e2e8f0;
        }
        .modern-table tr {
            border-bottom: 1px solid #e2e8f0;
            transition: background 0.18s;
        }
        .modern-table tr:hover {
            background: #f3eaff;
        }
        .modern-table td {
            color: #222;
        }
        .action-link {
            color: #667eea;
            margin-right: 0.7em;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.17s;
        }
        .action-link:hover {
            color: #764ba2;
            text-decoration: underline;
        }
        .btn-create {
            display: inline-block;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.7rem 1.7rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            text-decoration: none;
            box-shadow: 0 2px 10px rgba(102, 126, 234, 0.13);
            transition: background 0.2s;
            margin-top: 0.8rem;
        }
        .btn-create:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        @media (max-width: 700px) {
            .list-container {
                padding: 0.7rem 0.2rem;
            }
            .modern-table th, .modern-table td {
                padding: 0.55rem 0.3rem;
                font-size: 0.98rem;
            }
        }
    </style>
{% endblock %}
