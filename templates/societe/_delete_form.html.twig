<form method="post" action="{{ path('app_societe_delete', {'id': societe.id}) }}" onsubmit="return confirm('{{ 'societe.delete.confirm'|trans([], 'societe') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ societe.id) }}">
    <button class="btn">{{ 'societe.actions.delete'|trans([], 'societe') }}</button>
</form>
