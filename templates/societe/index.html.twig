{% extends 'base.html.twig' %}

{% block title %}Societe index{% endblock %}

{% block body %}
    <h1>Societe index</h1>

    <div class="societe-cards">
        {% for societe in societes %}
            <div class="societe-card">
                <div class="societe-card-header">
                    <span class="societe-card-title">{{ societe.nom }}</span>
                </div>
                <div class="societe-card-body">
                    <p><strong>Adresse :</strong> {{ societe.adress }}</p>
                    <p><strong>Email :</strong> {{ societe.email }}</p>
                    <p><strong>Téléphone :</strong> {{ societe.telephone }}</p>
                </div>
                <div class="societe-card-actions">
                    <a href="{{ path('app_societe_show', {'id': societe.id}) }}" class="btn-card">Voir</a>
                    <a href="{{ path('app_societe_edit', {'id': societe.id}) }}" class="btn-card">Modifier</a>
                </div>
            </div>
        {% else %}
            <p>Aucune société trouvée.</p>
        {% endfor %}
    </div>

    <a href="{{ path('app_societe_new') }}" class="btn-add">Créer une nouvelle société</a>

    <style>
        .societe-cards {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            margin-top: 2rem;
        }
        .societe-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(102, 126, 234, 0.13);
            padding: 2rem 1.5rem;
            min-width: 260px;
            max-width: 320px;
            flex: 1 1 260px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .societe-card:hover {
            transform: translateY(-6px) scale(1.03);
            box-shadow: 0 8px 32px rgba(102, 126, 234, 0.22);
        }
        .societe-card-header {
            margin-bottom: 1rem;
        }
        .societe-card-title {
            font-size: 1.3rem;
            font-weight: bold;
            color: #764ba2;
        }
        .societe-card-body p {
            margin: 0.2rem 0;
            color: #333;
        }
        .societe-card-actions {
            margin-top: 1.2rem;
            display: flex;
            gap: 1rem;
        }
        .btn-card {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.4rem 1.1rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-card:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        .btn-add {
            display: inline-block;
            margin-top: 2rem;
            background: #764ba2;
            color: #fff;
            padding: 0.6rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-add:hover {
            background: #667eea;
        }
    </style>
{% endblock %}
