{% extends 'base.html.twig' %}

{% block title %}{{ 'societe.index.title'|trans([], 'societe') }}{% endblock %}

{% block body %}
    <div class="societe-search">
        <input type="text" id="societeSearch" class="search-input" placeholder="Rechercher...">
        <span class="search-icon">🔍</span>
    </div>
    <h1>{{ 'societe.index.heading'|trans([], 'societe') }}</h1>

    <div id="societeList" class="societe-cards">
        {% for societe in societes %}
            <div class="societe-card">
                <div class="societe-card-header">
                    <span class="societe-card-title">{{ societe.nom }}</span>
                </div>
                <div class="societe-card-body">
                    <p><strong>{{ 'societe.index.address'|trans([], 'societe') }} :</strong> {{ societe.adress }}</p>
                    <p><strong>{{ 'societe.index.email'|trans([], 'societe') }} :</strong> {{ societe.email }}</p>
                    <p><strong>{{ 'societe.index.phone'|trans([], 'societe') }} :</strong> {{ societe.telephone }}</p>
                </div>
                <div class="societe-card-actions">
                    <a href="{{ path('app_societe_show', {'id': societe.id}) }}" class="btn-card">{{ 'societe.index.view'|trans([], 'societe') }}</a>
                    <a href="{{ path('app_societe_edit', {'id': societe.id}) }}" class="btn-card">{{ 'societe.index.edit'|trans([], 'societe') }}</a>
                </div>
            </div>
        {% else %}
            <p>{{ 'societe.index.none'|trans([], 'societe') }}</p>
        {% endfor %}
    </div>

    <a href="{{ path('app_societe_new') }}" class="btn-add">{{ 'societe.index.create_new'|trans([], 'societe') }}</a>
    <div id="societesEmpty" class="societe-empty" style="display:none; margin-top:1rem; color:#555;">Aucune société ne correspond à votre recherche.</div>

    <style>
        .societe-search {
            position: relative;
            display: block;
            max-width: 360px;
            margin: .25rem 0 .5rem auto; /* aligné à droite, plus haut */
        }
        .societe-search .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #764ba2;
            pointer-events: none;
        }
        .societe-search .search-input {
            width: 100%;
            padding: .45rem .75rem .45rem 2rem; /* place pour l'icône */
            border-radius: 999px; /* pill */
            border: 1px solid rgba(0,0,0,.15);
            background: #fff;
            box-shadow: 0 1px 2px rgba(0,0,0,.04) inset;
            font-size: .95rem;
            outline: none;
        }
        .societe-search .search-input::placeholder { color: #9aa0a6; }
        .societe-cards {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            margin-top: 2rem;
        }
        .societe-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(102, 126, 234, 0.13);
            padding: 2rem 1.5rem;
            min-width: 260px;
            max-width: 320px;
            flex: 1 1 260px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .societe-card:hover {
            transform: translateY(-6px) scale(1.03);
            box-shadow: 0 8px 32px rgba(102, 126, 234, 0.22);
        }
        .societe-card-header {
            margin-bottom: 1rem;
        }
        .societe-card-title {
            font-size: 1.3rem;
            font-weight: bold;
            color: #764ba2;
        }
        .societe-card-body p {
            margin: 0.2rem 0;
            color: #333;
        }
        .societe-card-actions {
            margin-top: 1.2rem;
            display: flex;
            gap: 1rem;
        }
        .btn-card {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 0.4rem 1.1rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-card:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
        .btn-add {
            display: inline-block;
            margin-top: 2rem;
            background: #764ba2;
            color: #fff;
            padding: 0.6rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-add:hover {
            background: #667eea;
        }
    </style>
    <script>
    (function(){
        function debounce(fn, delay){ let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn.apply(null,a), delay); }; }
        function filterCards(q){
            const query=(q||'').toLowerCase().trim();
            const cards=document.querySelectorAll('#societeList .societe-card');
            let visible=0;
            cards.forEach(card=>{
                const text=card.textContent.toLowerCase();
                const match=!query||text.includes(query);
                card.style.display = match ? '' : 'none';
                if(match) visible++;
            });
            const empty=document.getElementById('societesEmpty');
            if(empty) empty.style.display = visible===0 ? 'block' : 'none';
        }
        const input=document.getElementById('societeSearch');
        const clear=document.getElementById('societeSearchClear');
        if(input){ input.addEventListener('input', debounce(()=>filterCards(input.value), 150)); }
        if(clear){ clear.addEventListener('click', ()=>{ input.value=''; filterCards(''); input.focus(); }); }
        // initial
        filterCards('');
    })();
    </script>
{% endblock %}
