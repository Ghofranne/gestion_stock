<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>{{ 'profile.email.reset.subject'|trans([], 'profile') }}</title>
</head>
<body style="font-family:Arial,Helvetica,sans-serif;background:#f6f7fb;margin:0;padding:0">
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:24px 0">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;box-shadow:0 4px 24px rgba(102,126,234,.13);overflow:hidden">
          <tr>
            <td style="background:linear-gradient(135deg,#667eea,#764ba2);padding:18px 24px;color:#fff;font-weight:700;font-size:18px">StockPro</td>
          </tr>
          <tr>
            <td style="padding:24px">
              <h2 style="color:#111827;margin:0 0 8px 0;font-size:20px">{{ 'profile.email.reset.title'|trans([], 'profile') }}</h2>
              <p style="color:#374151;line-height:1.5;margin:8px 0 16px 0">{{ 'profile.email.reset.greeting'|trans({'%name%': user.prenom ?? ''}, 'profile')|trim }}</p>
              <p style="color:#374151;line-height:1.6;margin:0 0 16px 0">
                {{ 'profile.email.reset.instruction'|trans({'%expires%': expires_in}, 'profile') }}
              </p>
              <p style="margin:24px 0">
                <a href="{{ reset_url }}" style="display:inline-block;background:#667eea;color:#fff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:600">{{ 'profile.email.reset.button'|trans([], 'profile') }}</a>
              </p>
              <p style="color:#6b7280;font-size:13px;line-height:1.5">{{ 'profile.email.reset.ignore'|trans([], 'profile') }}</p>
              <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0"/>
              <p style="color:#9ca3af;font-size:12px">{{ 'profile.email.reset.fallback'|trans([], 'profile') }}<br>
                <a href="{{ reset_url }}" style="color:#6b7280">{{ reset_url }}</a>
              </p>
            </td>
          </tr>
          <tr>
            <td style="background:#f3f4f6;color:#6b7280;font-size:12px;padding:16px 24px;text-align:center">
              © {{ "now"|date('Y') }} StockPro — {{ 'profile.email.reset.footer'|trans([], 'profile') }}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
