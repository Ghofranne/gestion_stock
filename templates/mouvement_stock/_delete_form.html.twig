<form method="post" action="{{ path('app_mouvement_stock_delete', {'id': mouvement_stock.id}) }}" onsubmit="return confirm('{{ 'mouvement.index.confirm_delete'|trans([], 'mouvement') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mouvement_stock.id) }}">
    <button class="btn">{{ 'mouvement.actions.delete'|trans([], 'mouvement') }}</button>
</form>
