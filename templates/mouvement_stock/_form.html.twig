  display: grid;
  grid-template-columns: 1fr; /* mobile */
  gap: 10px;
  margin-top: 6px;
}
@media (min-width: 900px) {
  /* Use auto-fit so it falls back to 1 column if the container is narrower */
  .equipements-cards { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
}
.equip-card {
  position: relative;
  display: flex;
  gap: 12px;
  align-items: center;
  background: #f8faff;
  border: 1px solid #edf0ff;
  border-radius: 14px;
  padding: 12px 14px 12px 16px;
  cursor: pointer;
  transition: box-shadow .15s ease, transform .05s ease, border-color .15s ease, background .15s ease;
  user-select: none; /* évite de sélectionner le texte au clic */
}
.equip-card::before {
  content: '';
  position: absolute;
  left: 6px;
  top: 8px;
  bottom: 8px;
  width: 4px;
  background: linear-gradient(180deg, #6c5ce7, #8a7dff);
  border-radius: 8px;
}
.equip-card:hover {
  box-shadow: 0 4px 14px rgba(108,92,231,.15);
  border-color: #e2e6ff;
}
.equip-card:active { transform: translateY(1px); }
.equip-card.selected { border-color: #6c5ce7; background: #f3f2ff; box-shadow: 0 0 0 2px rgba(108,92,231,.12); }
.equip-card__icon {
  width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: #f1f3ff; flex: 0 0 36px;
}
.equip-card__icon .equip-svg { display: block; }
.equip-card__body { flex: 1; min-width: 0; }
.equip-card__head { display:flex; align-items:center; justify-content: space-between; gap:8px; }
.equip-card__title { font-weight: 700; margin-bottom: 2px; color: #1d2140; }
.equip-card__sub { color: #6b6f8a; font-size: 0.92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.equip-badge { display:inline-block; padding:2px 8px; border-radius:999px; font-size:.72rem; font-weight:700; letter-spacing:.2px; border:1px solid transparent; white-space:nowrap; }
.equip-badge--success { background:#ecfdf5; color:#047857; border-color:#a7f3d0; }
.equip-badge--info { background:#eef2ff; color:#3730a3; border-color:#c7d2fe; }
.equip-badge--danger { background:#fef2f2; color:#b91c1c; border-color:#fecaca; }
.equip-badge--warning { background:#fffbeb; color:#92400e; border-color:#fde68a; }
.equip-badge--neutral { background:#f3f4f6; color:#374151; border-color:#e5e7eb; }
.equipements-row { justify-content: flex-start; }
.equipements-row #equipements-group { align-items: flex-start; max-width: 100%; }
.equipements-toolbar { display:flex; align-items:center; justify-content:flex-start; gap:8px; margin: 0 0 6px; }
.equipements-toolbar .checkbox-inline { display:flex; align-items:center; gap:6px; color:#4b4f6b; font-size: .85rem; line-height:1; }
.equipements-toolbar input[type="checkbox"] {
  appearance: auto; /* reset any global custom check style */
  -webkit-appearance: checkbox;
  width: 16px; height: 16px; margin: 0; accent-color: #6c5ce7;
}
.equip-type-pills { display:flex; gap:6px; flex-wrap: wrap; }
.equip-type-pills .pill {
  border: 1px solid #e2e6ff; background: #fff; color:#3a3f63; padding:4px 8px; border-radius: 999px; cursor:pointer; font-size:.82rem;
}
.equip-type-pills .pill:hover { border-color:#cfd6ff; background:#f7f8ff; }
.equip-type-pills .pill.active { border-color:#6c5ce7; background:#f3f2ff; color:#2a2766; box-shadow: 0 0 0 2px rgba(108,92,231,.08); }
</style>
