<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'profile.auth.reset.title'|trans([], 'profile') }}</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            min-height: 100vh; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;
        }
        .bg-shape { position:absolute; border-radius:50%; opacity:.1; animation:float 6s ease-in-out infinite; }
        .bg-shape:nth-child(1){ width:200px; height:200px; background:rgba(255,255,255,.2); top:10%; left:10%; animation-delay:0s; }
        .bg-shape:nth-child(2){ width:150px; height:150px; background:rgba(255,255,255,.15); bottom:20%; right:15%; animation-delay:2s; }
        .bg-shape:nth-child(3){ width:300px; height:300px; background:rgba(255,255,255,.05); top:50%; left:-50px; animation-delay:4s; }
        @keyframes float{ 0%,100%{transform:translateY(0) rotate(0)} 33%{transform:translateY(-30px) rotate(5deg)} 66%{transform:translateY(-15px) rotate(-5deg)} }
        .container{
            background: rgba(255,255,255,.98); backdrop-filter: blur(25px);
            padding: 2.5rem; border-radius:24px; box-shadow:0 30px 60px rgba(0,0,0,.15);
            width:100%; max-width: 480px; position:relative; border:1px solid rgba(255,255,255,.3);
            animation: slideUp .8s cubic-bezier(.34,1.56,.64,1);
        }
        @keyframes slideUp{ from{opacity:0; transform:translateY(50px) scale(.95)} to{opacity:1; transform:translateY(0) scale(1)} }
        .header{ text-align:center; margin-bottom:2rem; }
        .header::before{ content:'🔒'; font-size:2.4rem; display:block; margin-bottom:.75rem; animation:pulse 2s ease-in-out infinite; }
        @keyframes pulse{ 0%,100%{transform:scale(1)} 50%{transform:scale(1.1)} }
        .header h1{ font-size:2rem; font-weight:800; margin-bottom:.25rem; background:linear-gradient(135deg,#667eea,#764ba2,#f093fb); -webkit-background-clip:text; background-clip:text; color:transparent; }
        .header p{ color:#718096; }
        .alert{ background:#fee2e2; color:#7f1d1d; padding:1rem 1.25rem; border-radius:16px; border:1px solid #fecaca; margin-bottom:1rem; }
        label{ display:block; margin:.75rem 0 .5rem; color:#4a5568; font-weight:600; }
        input[type="password"]{ width:100%; padding:1rem 1.25rem; border:2px solid #e2e8f0; border-radius:16px; font-size:1rem; background:#f8fafc; transition:.3s; }
        input[type="password"]:focus{ outline:none; border-color:#667eea; background:#fff; box-shadow:0 0 0 4px rgba(102,126,234,.15); transform:translateY(-2px); }
        .btn{ width:100%; padding:1.1rem; background:linear-gradient(135deg,#667eea,#764ba2); color:#fff; border:none; border-radius:16px; font-weight:700; cursor:pointer; transition:.3s; margin-top:1rem; }
        .btn:hover{ transform:translateY(-3px); box-shadow:0 15px 30px rgba(102,126,234,.4); }
        .links{ margin-top:1rem; text-align:center; }
        .links a{ color:#667eea; text-decoration:none; font-weight:600; }
    </style>
</head>
<body>
    <div class="bg-shape"></div>
    <div class="bg-shape"></div>
    <div class="bg-shape"></div>

    <div class="container">
        <div class="header">
            <h1>{{ 'profile.auth.reset.heading'|trans([], 'profile') }}</h1>
            <p>{{ 'profile.auth.reset.instruction'|trans([], 'profile') }}</p>
        </div>

        {% if error %}
            <div class="alert">{{ error }}</div>
        {% endif %}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert" style="background:linear-gradient(135deg,#e6fffa,#b2f5ea); color:#234e52; border:1px solid #81e6d9;">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <form method="post">
            <label for="new_password">{{ 'profile.auth.reset.new_password'|trans([], 'profile') }}</label>
            <input id="new_password" name="new_password" type="password" required minlength="6">

            <label for="confirm_password">{{ 'profile.auth.reset.confirm_password'|trans([], 'profile') }}</label>
            <input id="confirm_password" name="confirm_password" type="password" required minlength="6">

            <button class="btn">{{ 'profile.auth.reset.submit'|trans([], 'profile') }}</button>
        </form>

        <div class="links">
            <a href="{{ path('app_login') }}">← {{ 'profile.auth.forgot.back_to_login'|trans([], 'profile') }}</a>
        </div>
    </div>
</body>
</html>
