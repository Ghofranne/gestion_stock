<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vérification 2FA</title>
  <style>
    :root { --bg1:#5b4bdb; --bg2:#6f42c1; --card-bg:#fff; --text:#212529; --muted:#6c757d; --primary:#0d6efd; --danger:#dc3545; }
    html, body { height: 100%; margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji"; color: var(--text); }
    body { background: linear-gradient(135deg, var(--bg1), var(--bg2)); }
    .wrap { min-height: 100%; display:flex; align-items:center; justify-content:center; padding: 24px; }
    .card { width: 100%; max-width: 560px; background: var(--card-bg); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,.12); overflow:hidden; }
    .card-header { background: var(--primary); color: #fff; padding: 16px 20px; display:flex; gap:.6rem; align-items:center; }
    .circle { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.25); display:flex; align-items:center; justify-content:center; font-weight:700; }
    .card-body { padding: 22px; }
    .alert { padding: 10px 12px; border-radius: 10px; margin: 0 0 12px; font-size: 14px; }
    .alert.info { background: #e7f1ff; color: #084298; }
    .alert.success { background: #e9f7ef; color: #0f5132; }
    .alert.danger { background: #fde7ea; color: #842029; }
    .muted-badge { background: #f1f3f5; color: #495057; border-radius: .5rem; padding: .35rem .6rem; font-size: .85rem; display:inline-block; }
    .label { display:block; margin: 0 0 6px; font-weight:600; font-size: 14px; }
    .otp { display:flex; gap: 8px; justify-content: center; flex-wrap: nowrap; }
    .otp input { width: 44px; height: 48px; text-align:center; font-size: 20px; padding: 0; border:1px solid #ced4da; border-radius: 10px; outline: none; box-sizing: border-box; }
    .otp input:focus { border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(13,110,253,.15); }
    @media (max-width: 420px) {
      .otp input { width: 36px; height: 44px; font-size: 18px; }
    }
    .help { color: var(--muted); font-size: 12px; margin-top: 6px; }
    .btn { display:block; width:100%; border:0; border-radius: 10px; padding: 10px 14px; font-weight:600; cursor:pointer; }
    .btn.primary { background: var(--primary); color:#fff; }
    .btn.ghost { background: transparent; color: var(--text); border: 1px solid #ced4da; }
    .divider { display:flex; align-items:center; gap:8px; color:#6c757d; font-size: 14px; margin: 16px 0; }
    .divider::before, .divider::after { content:""; height:1px; background:#dee2e6; flex:1; }
    details summary { cursor:pointer; color:#495057; }
    details[open] summary { margin-bottom: 8px; }
    .field { margin-bottom: 10px; }
    input[type="text"], input[type="password"], input[type="email"] { width: 100%; box-sizing: border-box; padding: 10px 12px; border:1px solid #ced4da; border-radius: 10px; font-size: 14px; }
    .resend { text-align:center; margin-top: 8px; }
    .resend button { background:none; border:0; color: var(--primary); cursor:pointer; font-weight:600; }
    .small { font-size: 12px; color: #6c757d; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="card-header">
        <div class="circle">🔒</div>
        <div>
          <div style="font-weight:700">Authentification à deux facteurs</div>
          <div class="small">Sécurisez votre accès</div>
        </div>
      </div>
      <div class="card-body">
        {% for label, messages in app.flashes %}
          {% for message in messages %}
            <div class="alert {{ label == 'danger' ? 'danger' : (label == 'success' ? 'success' : 'info') }}">{{ message }}</div>
          {% endfor %}
        {% endfor %}

        {% set email = app.user ? app.user.email : '' %}
        {% if email %}
          {% set parts = email|split('@') %}
          {% set local = parts[0] %}
          {% set masked_local = (local|length > 2) ? (local|slice(0,1) ~ '***' ~ local|slice(-1)) : (local|slice(0,1) ~ '***') %}
          <div class="small" style="margin-bottom:10px">Un code à 6 chiffres a été envoyé à <span class="muted-badge">{{ masked_local }}@{{ parts[1] }}</span>.</div>
        {% else %}
          <div class="small" style="margin-bottom:10px">Un code à 6 chiffres a été envoyé à votre adresse email.</div>
        {% endif %}

        <form id="email-code-form" method="post" action="{{ path('app_2fa_verify') }}">
          <input type="hidden" name="code" id="hidden-code" value="">
          <div class="field">
            <label class="label">Code reçu par email</label>
            <div class="otp">
              <input inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box" autocomplete="one-time-code">
              <input inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box">
              <input inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box">
              <input inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box">
              <input inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box">
              <input inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box">
            </div>
            <div class="help">Entrez les 6 chiffres (ex: 1 2 3 4 5 6)</div>
          </div>
          <button type="submit" class="btn primary">Vérifier</button>
        </form>

        <div class="divider">ou</div>

        <details>
          <summary>Utiliser un code de secours</summary>
          <form method="post" action="{{ path('app_2fa_verify') }}" class="mt-2">
            <div class="field">
              <label for="backup" class="label">Code de secours</label>
              <input type="text" name="backup" id="backup" maxlength="32" placeholder="Ex: ABCD-EFGH-1234">
            </div>
            <button type="submit" class="btn ghost">Utiliser le code de secours</button>
          </form>
        </details>

        <div class="resend">
          <form method="post" action="{{ path('app_2fa_resend') }}">
            <button type="submit">Renvoyer le code</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const inputs = Array.from(document.querySelectorAll('.otp .otp-box'));
      const hidden = document.getElementById('hidden-code');
      const form = document.getElementById('email-code-form');

      function updateHidden() {
        hidden.value = inputs.map(i => i.value || '').join('');
      }

      inputs.forEach((inp, idx) => {
        inp.addEventListener('input', () => {
          inp.value = inp.value.replace(/[^0-9]/g, '').slice(0,1);
          if (inp.value && idx < inputs.length - 1) inputs[idx + 1].focus();
          updateHidden();
        });
        inp.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !inp.value && idx > 0) inputs[idx - 1].focus();
        });
        inp.addEventListener('paste', (e) => {
          const text = (e.clipboardData || window.clipboardData).getData('text') || '';
          if (/^\d{6}$/.test(text)) {
            e.preventDefault();
            text.split('').forEach((ch, i) => { if (inputs[i]) inputs[i].value = ch; });
            inputs[inputs.length - 1].focus();
            updateHidden();
          }
        });
      });

      form.addEventListener('submit', (e) => {
        updateHidden();
        if (!/^\d{6}$/.test(hidden.value)) {
          e.preventDefault();
          inputs[0].focus();
        }
      });
    })();
  </script>
</body>
</html>
