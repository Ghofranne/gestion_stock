{% extends 'admin_base.html.twig' %}

{% block title %}Administration - Dépôts{% endblock %}

{% block body %}
<div class="admin-content">
    <div class="page-header">
        <h1>🏬 Gestion des Dépôts</h1>
        <p>Statistiques détaillées et analyse des dépôts de stockage</p>
    </div>

    <!-- Statistiques générales -->
    <div class="stats-grid">
        <div class="stat-card primary">
            <div class="stat-icon">🏬</div>
            <div class="stat-content">
                <div class="stat-number">{{ stats.total_depots }}</div>
                <div class="stat-label">Dépôts Total</div>
            </div>
        </div>
        
        <div class="stat-card success">
            <div class="stat-icon">📦</div>
            <div class="stat-content">
                <div class="stat-number">{{ stats.total_stock }}</div>
                <div class="stat-label">Stock Total</div>
            </div>
        </div>
        
        <div class="stat-card info">
            <div class="stat-icon">🔄</div>
            <div class="stat-content">
                <div class="stat-number">{{ stats.total_mouvements }}</div>
                <div class="stat-label">Mouvements Total</div>
            </div>
        </div>
        
        <div class="stat-card warning">
            <div class="stat-icon">⚡</div>
            <div class="stat-content">
                <div class="stat-number">{{ stats.depots_actifs }}</div>
                <div class="stat-label">Dépôts Actifs</div>
            </div>
        </div>
    </div>

    <!-- Graphiques circulaires -->
    <div class="charts-section">
        <div class="chart-container">
            <h3>Stock Moyen</h3>
            <div class="circular-chart">
                <svg viewBox="0 0 36 36" class="circular-chart-svg">
                    <path class="circle-bg"
                        d="M18 2.0845
                           a 15.9155 15.9155 0 0 1 0 31.831
                           a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <path class="circle"
                        stroke-dasharray="{{ stats.moyenne_stock > 0 ? (stats.moyenne_stock / (stats.moyenne_stock + 10) * 100)|round : 0 }}, 100"
                        d="M18 2.0845
                           a 15.9155 15.9155 0 0 1 0 31.831
                           a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <text x="18" y="20.35" class="percentage">{{ stats.moyenne_stock }}</text>
                    <text x="18" y="24" class="label">moy/dépôt</text>
                </svg>
            </div>
        </div>
        
        <div class="chart-container">
            <h3>Activité Mouvements</h3>
            <div class="circular-chart">
                <svg viewBox="0 0 36 36" class="circular-chart-svg">
                    <path class="circle-bg"
                        d="M18 2.0845
                           a 15.9155 15.9155 0 0 1 0 31.831
                           a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <path class="circle circle-success"
                        stroke-dasharray="{{ stats.moyenne_mouvements > 0 ? (stats.moyenne_mouvements / (stats.moyenne_mouvements + 5) * 100)|round : 0 }}, 100"
                        d="M18 2.0845
                           a 15.9155 15.9155 0 0 1 0 31.831
                           a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <text x="18" y="20.35" class="percentage">{{ stats.moyenne_mouvements }}</text>
                    <text x="18" y="24" class="label">moy/dépôt</text>
                </svg>
            </div>
        </div>
        
        <div class="chart-container">
            <h3>Taux d'Occupation</h3>
            <div class="circular-chart">
                <svg viewBox="0 0 36 36" class="circular-chart-svg">
                    <path class="circle-bg"
                        d="M18 2.0845
                           a 15.9155 15.9155 0 0 1 0 31.831
                           a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <path class="circle circle-warning"
                        stroke-dasharray="{{ stats.total_depots > 0 ? (stats.depots_avec_stock / stats.total_depots * 100)|round : 0 }}, 100"
                        d="M18 2.0845
                           a 15.9155 15.9155 0 0 1 0 31.831
                           a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <text x="18" y="20.35" class="percentage">{{ stats.total_depots > 0 ? ((stats.depots_avec_stock / stats.total_depots * 100)|round) : 0 }}%</text>
                    <text x="18" y="24" class="label">avec stock</text>
                </svg>
            </div>
        </div>
        
        <div class="chart-container">
            <h3>Taux d'Activité</h3>
            <div class="circular-chart">
                <svg viewBox="0 0 36 36" class="circular-chart-svg">
                    <path class="circle-bg"
                        d="M18 2.0845
                           a 15.9155 15.9155 0 0 1 0 31.831
                           a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <path class="circle circle-info"
                        stroke-dasharray="{{ stats.total_depots > 0 ? (stats.depots_actifs / stats.total_depots * 100)|round : 0 }}, 100"
                        d="M18 2.0845
                           a 15.9155 15.9155 0 0 1 0 31.831
                           a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <text x="18" y="20.35" class="percentage">{{ stats.total_depots > 0 ? ((stats.depots_actifs / stats.total_depots * 100)|round) : 0 }}%</text>
                    <text x="18" y="24" class="label">actifs</text>
                </svg>
            </div>
        </div>
    </div>

    <div class="content-grid">
        <!-- Top 5 Dépôts les plus fournis -->
        <div class="panel">
            <div class="panel-header">
                <h2>🏆 Top 5 - Dépôts les plus fournis</h2>
            </div>
            <div class="panel-body">
                {% if top_depots is empty %}
                    <div class="empty-state">
                        <p>Aucune donnée disponible</p>
                    </div>
                {% else %}
                    <div class="ranking-list">
                        {% for index, data in top_depots %}
                            <div class="ranking-item">
                                <div class="rank-badge">{{ index + 1 }}</div>
                                <div class="depot-info">
                                    <div class="depot-name">{{ data.depot.nom }}</div>
                                    <div class="depot-location">📍 {{ data.ville }}</div>
                                    <div class="depot-society">🏢 {{ data.societe_nom }}</div>
                                </div>
                                <div class="depot-stats">
                                    <div class="stat-item">
                                        <span class="stat-value">{{ data.stock_actuel }}</span>
                                        <span class="stat-unit">équipements</span>
                                    </div>
                                    <div class="stat-item">
                                        <span class="stat-value">{{ data.nb_mouvements }}</span>
                                        <span class="stat-unit">mouvements</span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Répartition par société -->
        <div class="panel">
            <div class="panel-header">
                <h2>🏢 Répartition par société</h2>
            </div>
            <div class="panel-body">
                {% if depots_par_societe is empty %}
                    <div class="empty-state">
                        <p>Aucune donnée disponible</p>
                    </div>
                {% else %}
                    <div class="distribution">
                        {% for societe, count in depots_par_societe %}
                            <div class="distribution-item">
                                <div class="distribution-name">{{ societe }}</div>
                                <div class="distribution-count">
                                    <span class="count-number">{{ count }}</span>
                                    <span class="count-label">dépôt{{ count > 1 ? 's' : '' }}</span>
                                </div>
                                <div class="distribution-bar">
                                    <div class="distribution-progress" style="width: {{ (count / stats.total_depots * 100)|round }}%"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Répartition par ville -->
    <div class="panel full-width">
        <div class="panel-header">
            <h2>🗺️ Répartition géographique</h2>
        </div>
        <div class="panel-body">
            {% if depots_par_ville is empty %}
                <div class="empty-state">
                    <p>Aucune donnée géographique disponible</p>
                </div>
            {% else %}
                <div class="geo-distribution">
                    {% for ville, count in depots_par_ville %}
                        <div class="geo-item">
                            <div class="geo-name">📍 {{ ville }}</div>
                            <div class="geo-stats">
                                <span class="geo-count">{{ count }} dépôt{{ count > 1 ? 's' : '' }}</span>
                                <span class="geo-percentage">{{ (count / stats.total_depots * 100)|round }}%</span>
                            </div>
                            <div class="geo-bar">
                                <div class="geo-progress" style="width: {{ (count / stats.total_depots * 100)|round }}%"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Liste complète des dépôts -->
    <div class="panel full-width">
        <div class="panel-header">
            <h2>📋 Liste complète des dépôts</h2>
            <div class="panel-actions">
                <a href="{{ path('app_depot_new') }}" class="btn btn-primary">
                    + Nouveau dépôt
                </a>
            </div>
        </div>
        <div class="panel-body">
            {% if depots_data is empty %}
                <div class="empty-state">
                    <p>Aucun dépôt enregistré</p>
                    <a href="{{ path('app_depot_new') }}" class="btn btn-primary">Créer le premier dépôt</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Dépôt</th>
                                <th>Société</th>
                                <th>Ville</th>
                                <th>Stock</th>
                                <th>Entrées</th>
                                <th>Sorties</th>
                                <th>Total Mouvements</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for data in depots_data %}
                                <tr>
                                    <td>
                                        <div class="depot-cell">
                                            <div class="depot-name">{{ data.depot.nom }}</div>
                                            <div class="depot-address">{{ data.depot.adresse|slice(0, 40) }}{% if data.depot.adresse|length > 40 %}...{% endif %}</div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="society-tag">{{ data.societe_nom }}</span>
                                    </td>
                                    <td>
                                        <span class="city-tag">{{ data.ville }}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-stock">{{ data.stock_actuel }}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-success">{{ data.nb_mouvements_entree }}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-danger">{{ data.nb_mouvements_sortie }}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-info">{{ data.nb_mouvements }}</span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="{{ path('app_depot_show', {'id': data.depot.id}) }}" class="btn btn-sm btn-outline">
                                                👁️ Voir
                                            </a>
                                            <a href="{{ path('app_depot_edit', {'id': data.depot.id}) }}" class="btn btn-sm btn-outline">
                                                ✏️ Modifier
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.admin-content {
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
}

.page-header {
    margin-bottom: 2rem;
}

.page-header h1 {
    margin: 0 0 0.5rem 0;
    color: #2d3748;
    font-size: 2.5rem;
}

.page-header p {
    color: #718096;
    font-size: 1.1rem;
    margin: 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: transform 0.2s ease;
}

.stat-card:hover {
    transform: translateY(-2px);
}

.stat-card.primary { border-left: 5px solid #667eea; }
.stat-card.success { border-left: 5px solid #48bb78; }
.stat-card.info { border-left: 5px solid #4299e1; }
.stat-card.warning { border-left: 5px solid #ed8936; }

.stat-icon {
    font-size: 3rem;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    border-radius: 15px;
}

.stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: #2d3748;
    margin-bottom: 0.5rem;
}

.stat-label {
    color: #718096;
    font-size: 1rem;
    font-weight: 500;
}

.charts-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
    padding: 2rem;
    background: white;
    border-radius: 15px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

.chart-container {
    text-align: center;
    padding: 1rem;
}

.chart-container h3 {
    margin-bottom: 1.5rem;
    color: #2d3748;
    font-size: 1.1rem;
    font-weight: 600;
}

.circular-chart {
    display: block;
    margin: 0 auto;
    max-width: 150px;
    max-height: 150px;
}

.circular-chart-svg {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    max-height: 100%;
}

.circle-bg {
    fill: none;
    stroke: #e2e8f0;
    stroke-width: 2.8;
}

.circle {
    fill: none;
    stroke-width: 2.8;
    stroke-linecap: round;
    animation: progress 1.5s ease-in-out forwards;
    stroke: #667eea;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
}

.circle-success {
    stroke: #48bb78;
}

.circle-warning {
    stroke: #ed8936;
}

.circle-info {
    stroke: #4299e1;
}

.percentage {
    fill: #2d3748;
    font-family: 'Inter', sans-serif;
    font-size: 0.5em;
    font-weight: 700;
    text-anchor: middle;
}

.label {
    fill: #718096;
    font-family: 'Inter', sans-serif;
    font-size: 0.3em;
    font-weight: 500;
    text-anchor: middle;
}

@keyframes progress {
    0% {
        stroke-dasharray: 0 100;
    }
}

.chart-container:hover .circular-chart {
    transform: scale(1.05);
    transition: transform 0.3s ease;
}

.chart-container:hover h3 {
    color: #667eea;
    transition: color 0.3s ease;
}

.content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
}

.panel {
    background: white;
    border-radius: 15px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    overflow: hidden;
}

.panel.full-width {
    grid-column: 1 / -1;
}

.panel-header {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.panel-header h2 {
    margin: 0;
    font-size: 1.3rem;
}

.panel-body {
    padding: 2rem;
}

.ranking-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.ranking-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 10px;
    transition: all 0.2s ease;
}

.ranking-item:hover {
    background: #e2e8f0;
    transform: translateX(5px);
}

.rank-badge {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #48bb78, #38a169);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.2rem;
}

.depot-info {
    flex: 1;
}

.depot-name {
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 0.25rem;
}

.depot-location, .depot-society {
    color: #718096;
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
}

.depot-stats {
    display: flex;
    gap: 1rem;
}

.stat-item {
    text-align: center;
}

.stat-value {
    display: block;
    font-weight: 700;
    color: #2d3748;
    font-size: 1.1rem;
}

.stat-unit {
    font-size: 0.8rem;
    color: #718096;
}

.distribution, .geo-distribution {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.distribution-item, .geo-item {
    padding: 1rem;
    background: #f8fafc;
    border-radius: 10px;
}

.distribution-name, .geo-name {
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 0.5rem;
}

.distribution-count, .geo-stats {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.count-number, .geo-count {
    font-weight: 700;
    color: #4299e1;
    font-size: 1.2rem;
}

.count-label, .geo-percentage {
    color: #718096;
    font-size: 0.9rem;
}

.distribution-bar, .geo-bar {
    height: 8px;
    background: #e2e8f0;
    border-radius: 4px;
    overflow: hidden;
}

.distribution-progress, .geo-progress {
    height: 100%;
    background: linear-gradient(135deg, #4299e1, #3182ce);
    transition: width 0.3s ease;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table th,
.data-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
}

.data-table th {
    background: #f8fafc;
    font-weight: 600;
    color: #2d3748;
}

.depot-cell {
    min-width: 200px;
}

.depot-address {
    color: #718096;
    font-size: 0.9rem;
    margin-top: 0.25rem;
}

.society-tag, .city-tag {
    background: #e2e8f0;
    color: #4a5568;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
}

.badge {
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
}

.badge-stock {
    background: #bee3f8;
    color: #2b6cb0;
}

.badge-success {
    background: #c6f6d5;
    color: #22543d;
}

.badge-danger {
    background: #fed7d7;
    color: #742a2a;
}

.badge-info {
    background: #bee3f8;
    color: #2b6cb0;
}

.action-buttons {
    display: flex;
    gap: 0.5rem;
}

.btn {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
}

.btn-outline {
    background: transparent;
    color: #4a5568;
    border: 1px solid #e2e8f0;
}

.btn-outline:hover {
    background: #f8fafc;
    border-color: #cbd5e0;
}

.btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
}

.empty-state {
    text-align: center;
    padding: 3rem;
    color: #718096;
}

.table-responsive {
    overflow-x: auto;
}

@media (max-width: 768px) {
    .content-grid {
        grid-template-columns: 1fr;
    }
    
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .ranking-item {
        flex-direction: column;
        text-align: center;
    }
    
    .depot-stats {
        justify-content: center;
    }
}
</style>
{% endblock %}
