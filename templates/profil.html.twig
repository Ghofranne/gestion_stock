{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans([], 'profile') }}{% endblock %}

{% block stylesheets %}
<style>
    .profile-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem;
    }

    .profile-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: white;
        margin: 0 auto 1rem;
        box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
    }

    .profile-name {
        font-size: 2rem;
        font-weight: bold;
        color: #2d3748;
        margin-bottom: 0.5rem;
    }

    .profile-role {
        color: #718096;
        font-size: 1.1rem;
        margin-bottom: 1rem;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .profile-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

    .profile-card:hover {
        transform: translateY(-5px);
    }

    .card-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #2d3748;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: #718096;
        font-weight: 500;
    }

    .info-value {
        color: #2d3748;
        font-weight: 600;
    }

    .btn-profile {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        margin: 0.25rem;
    }

    .btn-profile:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
        color: white;
        text-decoration: none;
    }

    @media (max-width: 768px) {
        .profile-container {
            padding: 1rem;
        }
        .profile-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="profile-container">
    <!-- En-tête du profil -->
    <div class="profile-header">
        <div class="profile-avatar">👤</div>
        <h1 class="profile-name">
            {% if app.user and (app.user.prenom or app.user.nom) %}
                {{ app.user.prenom ?? '' }} {{ app.user.nom ?? '' }}
            {% else %}
                {{ app.user ? app.user.email|split('@')[0] : ('profile.user'|trans([], 'profile')) }}
            {% endif %}
        </h1>
        <p class="profile-role">{{ app.user.roles[0] == 'ROLE_ADMIN' ? ('profile.role_admin'|trans([], 'profile')) : ('profile.role_user'|trans([], 'profile')) }}</p>
    </div>

    <!-- Grille des sections -->
    <div class="profile-grid">
        <!-- Informations personnelles -->
        <div class="profile-card">
            <h2 class="card-title">
                <span>👤</span>
                {{ 'profile.personal_info'|trans([], 'profile') }}
            </h2>
            <div class="info-row">
                <span class="info-label">{{ 'profile.email_label'|trans([], 'profile') }}</span>
                <span class="info-value">{{ app.user.email }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.phone'|trans([], 'profile') }}</span>
                <span class="info-value">{{ app.user.telephone ?? ('profile.not_provided'|trans([], 'profile')) }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.position'|trans([], 'profile') }}</span>
                <span class="info-value">{{ app.user.poste ?? ('profile.not_provided'|trans([], 'profile')) }}</span>
            </div>
            <div style="margin-top: 1.5rem;">
                <a href="{{ path('app_profil_edit') }}" class="btn-profile">{{ 'profile.edit_info'|trans([], 'profile') }}</a>
            </div>
        </div>

        <!-- Sécurité -->
        <div class="profile-card">
            <h2 class="card-title">
                <span>🔒</span>
                {{ 'profile.security'|trans([], 'profile') }}
            </h2>
            <div class="info-row">
                <span class="info-label">{{ 'profile.password_label'|trans([], 'profile') }}</span>
                <span class="info-value">••••••••</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.last_login'|trans([], 'profile') }}</span>
                <span class="info-value">{{ app.user.lastLoginAt ? app.user.lastLoginAt|date('d/m/Y H:i') : ('profile.first_login'|trans([], 'profile')) }}</span>
            </div>
            <div style="margin-top: 1.5rem;">
                <a href="{{ path('app_profil_password') }}" class="btn-profile">{{ 'profile.change_password'|trans([], 'profile') }}</a>
            </div>
        </div>

        <!-- Préférences -->
        <div class="profile-card">
            <h2 class="card-title">
                <span>⚙️</span>
                {{ 'profile.preferences_label'|trans([], 'profile') }}
            </h2>
            <div class="info-row">
                <span class="info-label">{{ 'profile.language'|trans([], 'profile') }}</span>
                <span class="info-value">{{ preferences.language ?? ('profile.lang.fr'|trans([], 'profile')) }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.date_format'|trans([], 'profile') }}</span>
                <span class="info-value">{{ preferences.date_format ?? 'DD/MM/YYYY' }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.notifications'|trans([], 'profile') }}</span>
                <span class="info-value">{{ (preferences.notifications ?? true) ? ('profile.notifications_on'|trans([], 'profile')) : ('profile.notifications_off'|trans([], 'profile')) }}</span>
            </div>
            <div style="margin-top: 1.5rem;">
                <a href="{{ path('app_profil_preferences') }}" class="btn-profile">{{ 'profile.edit_preferences'|trans([], 'profile') }}</a>
            </div>
        </div>

        <!-- Permissions -->
        <div class="profile-card">
            <h2 class="card-title">
                <span>🔐</span>
                {{ 'profile.permissions'|trans([], 'profile') }}
            </h2>
            <div class="info-row">
                <span class="info-label">{{ 'profile.role'|trans([], 'profile') }}</span>
                <span class="info-value">{{ app.user.roles[0] == 'ROLE_ADMIN' ? ('profile.role_admin'|trans([], 'profile')) : ('profile.role_user'|trans([], 'profile')) }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.companies_accessible'|trans([], 'profile') }}</span>
                <span class="info-value">{{ societes_count ?? ('profile.all'|trans([], 'profile')) }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.depots_assigned'|trans([], 'profile') }}</span>
                <span class="info-value">{{ depots_count ?? ('profile.all'|trans([], 'profile')) }}</span>
            </div>
        </div>

        <!-- Activité récente -->
        <div class="profile-card">
            <h2 class="card-title">
                <span>📊</span>
                {{ 'profile.recent_activity'|trans([], 'profile') }}
            </h2>
            <div class="info-row">
                <span class="info-label">{{ 'profile.equipments_added'|trans([], 'profile') }}</span>
                <span class="info-value">{{ equipements_count ?? 0 }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.movements_created'|trans([], 'profile') }}</span>
                <span class="info-value">{{ mouvements_count ?? 0 }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">{{ 'profile.last_action'|trans([], 'profile') }}</span>
                <span class="info-value">{{ last_activity ?? ('profile.no_activity'|trans([], 'profile')) }}</span>
            </div>
        </div>

        <!-- Actions rapides -->
        <div class="profile-card">
            <h2 class="card-title">
                <span>⚡</span>
                {{ 'profile.quick_actions'|trans([], 'profile') }}
            </h2>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <a href="#" class="btn-profile">{{ 'profile.export_data'|trans([], 'profile') }}</a>
                <a href="#" class="btn-profile">{{ 'profile.download_report'|trans([], 'profile') }}</a>
                <a href="{{ path('app_logout') }}" class="btn-profile" style="background: linear-gradient(135deg, #e53e3e, #c53030);">
                    {{ 'profile.logout'|trans([], 'profile') }}
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
