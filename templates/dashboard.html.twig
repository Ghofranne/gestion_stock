{% extends 'base.html.twig' %}

{% block title %}StockPro - Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Dashboard Styles */
        .dashboard {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: calc(100vh - 80px);
            padding: 2rem 0;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .dashboard-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            margin-bottom: 0.5rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .dashboard-subtitle {
            font-size: 1.2rem;
            color: rgba(255, 255, 255, 0.9);
            margin: 0;
        }

        /* Grid Layout */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .dashboard-content {
            display: grid;
            gap: 2rem;
        }

        .dashboard-row {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
        }

        .dashboard-col-8,
        .dashboard-col-4 {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        /* Cards */
        .dashboard-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        .dashboard-card h3 {
            font-size: 1.3rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 1.5rem;
        }

        /* Utility classes */
        .flex {
            display: flex;
        }

        .justify-between {
            justify-content: space-between;
        }

        .items-center {
            align-items: center;
        }

        .text-center {
            text-align: center;
        }

        .mt-20 {
            margin-top: 2rem;
        }

        /* Statistics */
        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #333;
            margin: 0.5rem 0;
        }

        .dashboard-icon {
            font-size: 3rem;
            opacity: 0.8;
        }

        .text-success {
            color: #4CAF50;
            font-weight: 600;
        }

        .text-info {
            color: #2196F3;
            font-weight: 600;
        }

        .text-warning {
            color: #FF9800;
            font-weight: 600;
        }

        .stat-number.text-warning {
            color: #FF9800;
        }

        /* Table */
        .table-container {
            overflow-x: auto;
            margin: 1rem 0;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .table th {
            background: linear-gradient(45deg, #4CAF50, #45a049);
            color: white;
            padding: 1rem;
            text-align: left;
            font-weight: 600;
        }

        .table td {
            padding: 1rem;
            border-bottom: 1px solid #eee;
        }

        .table tr:hover {
            background: rgba(76, 175, 80, 0.05);
        }

        .table tr:last-child td {
            border-bottom: none;
        }

        /* Badges */
        .badge {
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
            color: white;
        }

        .badge-success {
            background: linear-gradient(45deg, #4CAF50, #45a049);
        }

        .badge-warning {
            background: linear-gradient(45deg, #FF9800, #F57C00);
        }

        .badge-danger {
            background: linear-gradient(45deg, #F44336, #D32F2F);
        }

        /* Status */
        .status {
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .status-completed {
            background: #d4edda;
            color: #155724;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        /* Buttons */
        .btn {
            padding: 0.8rem 2rem;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
            cursor: pointer;
        }

        .btn-secondary {
            background: linear-gradient(45deg, #6c757d, #5a6268);
            color: white;
        }

        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(108, 117, 125, 0.3);
            color: white;
            text-decoration: none;
        }

        /* Quick Actions */
        .quick-actions {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .quick-action-btn {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            background: linear-gradient(45deg, #4CAF50, #45a049);
            color: white;
            text-decoration: none;
            border-radius: 12px;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .quick-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(76, 175, 80, 0.4);
            color: white;
            text-decoration: none;
        }

        .quick-action-icon {
            font-size: 1.5rem;
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Depot Stats */
        .depot-stats {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .depot-stat-item {
            padding: 1rem;
            background: rgba(76, 175, 80, 0.1);
            border-radius: 12px;
            border-left: 4px solid #4CAF50;
        }

        .depot-name {
            font-weight: 600;
            color: #333;
            margin-bottom: 0.5rem;
        }

        .depot-count {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 0.8rem;
        }

        .depot-bar {
            width: 100%;
            height: 8px;
            background: rgba(76, 175, 80, 0.2);
            border-radius: 4px;
            overflow: hidden;
        }

        .depot-progress {
            height: 100%;
            background: linear-gradient(45deg, #4CAF50, #45a049);
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .container {
                padding: 0 1rem;
            }

            .dashboard-title {
                font-size: 2rem;
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .dashboard-row {
                grid-template-columns: 1fr;
            }

            .dashboard-card {
                padding: 1.5rem;
            }

            .table {
                font-size: 0.9rem;
            }

            .table th,
            .table td {
                padding: 0.5rem;
            }
        }

        @media (max-width: 480px) {
            .dashboard {
                padding: 1rem 0;
            }

            .dashboard-header {
                margin-bottom: 2rem;
            }

            .dashboard-title {
                font-size: 1.8rem;
            }

            .dashboard-subtitle {
                font-size: 1rem;
            }

            .stat-number {
                font-size: 2rem;
            }

            .dashboard-icon {
                font-size: 2rem;
            }

            .quick-actions {
                gap: 0.8rem;
            }

            .quick-action-btn {
                padding: 0.8rem;
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard">
        <div class="container">
            <div class="dashboard-header">
                <h1 class="dashboard-title">📊 Dashboard - Vue d'ensemble</h1>
                <p class="dashboard-subtitle">Bienvenue {{ app.user ? app.user.username : 'Utilisateur' }}, voici un aperçu de votre stock multi-dépôts</p>
            </div>
            
            <!-- Quick Stats -->
            <div class="dashboard-grid">
                <div class="dashboard-card">
                    <div class="flex justify-between items-center">
                        <div>
                            <h3>Total Équipements</h3>
                            <div class="stat-number" data-stat="totalEquipments">{{ totalEquipments ?? '1,247' }}</div>
                            <p class="text-success">+12% ce mois</p>
                        </div>
                        <div class="dashboard-icon">🛠️</div>
                    </div>
                </div>
                
                <div class="dashboard-card">
                    <div class="flex justify-between items-center">
                        <div>
                            <h3>Dépôts Actifs</h3>
                            <div class="stat-number" data-stat="totalDepots">{{ totalDepots ?? '15' }}</div>
                            <p class="text-info">Tous opérationnels</p>
                        </div>
                        <div class="dashboard-icon">🏢</div>
                    </div>
                </div>
                
                <div class="dashboard-card">
                    <div class="flex justify-between items-center">
                        <div>
                            <h3>Mouvements Aujourd'hui</h3>
                            <div class="stat-number" data-stat="todayMovements">{{ todayMovements ?? '89' }}</div>
                            <p class="text-warning">23 en attente</p>
                        </div>
                        <div class="dashboard-icon">📊</div>
                    </div>
                </div>
                
                <div class="dashboard-card">
                    <div class="flex justify-between items-center">
                        <div>
                            <h3>Alertes Stock</h3>
                            <div class="stat-number text-warning" data-stat="stockAlerts">{{ stockAlerts ?? '5' }}</div>
                            <p class="text-warning">Niveaux critiques</p>
                        </div>
                        <div class="dashboard-icon">⚠️</div>
                    </div>
                </div>
            </div>
            
            <!-- Recent Activities & Quick Actions -->
            <div class="dashboard-content">
                <div class="dashboard-row">
                    <div class="dashboard-col-8">
                        <div class="dashboard-card">
                            <h3>📈 Mouvements Récents</h3>
                            <div class="table-container">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Équipement</th>
                                            <th>Dépôt</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>{{ "now"|date("d/m/Y H:i") }}</td>
                                            <td><span class="badge badge-success">Entrée</span></td>
                                            <td>TPE-001234</td>
                                            <td>Dépôt Central</td>
                                            <td><span class="status status-completed">Terminé</span></td>
                                        </tr>
                                        <tr>
                                            <td>{{ "now"|date_modify("-2 hours")|date("d/m/Y H:i") }}</td>
                                            <td><span class="badge badge-warning">Transfer</span></td>
                                            <td>SIM-789012</td>
                                            <td>Dépôt Nord → Sud</td>
                                            <td><span class="status status-pending">En cours</span></td>
                                        </tr>
                                        <tr>
                                            <td>{{ "now"|date_modify("-4 hours")|date("d/m/Y H:i") }}</td>
                                            <td><span class="badge badge-danger">Sortie</span></td>
                                            <td>CARTE-345678</td>
                                            <td>Dépôt Est</td>
                                            <td><span class="status status-completed">Terminé</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="text-center mt-20">
                                <a href="{{ path('stock') }}" class="btn btn-secondary">Voir tous les mouvements</a>
                            </div>
                        </div>
                    </div>
                    
                    <div class="dashboard-col-4">
                        <div class="dashboard-card">
                            <h3>⚡ Actions Rapides</h3>
                            <div class="quick-actions">
                                <a href="{{ path('app_equipement_index') }}" class="quick-action-btn">
                                    <div class="quick-action-icon">➕</div>
                                    <span>Ajouter Équipement</span>
                                </a>
                                
                                <a href="{{ path('app_mouvement_stock_index') }}" class="quick-action-btn">
                                    <div class="quick-action-icon">🔄</div>
                                    <span>Nouveau Transfer</span>
                                </a>
                                
                                <a href="{{ path('app_depot_index') }}" class="quick-action-btn">
                                    <div class="quick-action-icon">🏢</div>
                                    <span>Gérer Dépôts</span>
                                </a>
                                
                                <a href="{{ path('home') }}" class="quick-action-btn">
                                    <div class="quick-action-icon">📈</div>
                                    <span>Générer Rapport</span>
                                </a>
                            </div>
                        </div>
                        
                        <div class="dashboard-card">
                            <h3>📊 Stock par Dépôt</h3>
                            <div class="depot-stats">
                                <div class="depot-stat-item">
                                    <div class="depot-name">Dépôt Central</div>
                                    <div class="depot-count">456 équipements</div>
                                    <div class="depot-bar">
                                        <div class="depot-progress" style="width: 85%;"></div>
                                    </div>
                                </div>
                                
                                <div class="depot-stat-item">
                                    <div class="depot-name">Dépôt Nord</div>
                                    <div class="depot-count">234 équipements</div>
                                    <div class="depot-bar">
                                        <div class="depot-progress" style="width: 65%;"></div>
                                    </div>
                                </div>
                                
                                <div class="depot-stat-item">
                                    <div class="depot-name">Dépôt Sud</div>
                                    <div class="depot-count">189 équipements</div>
                                    <div class="depot-bar">
                                        <div class="depot-progress" style="width: 45%;"></div>
                                    </div>
                                </div>
                                
                                <div class="depot-stat-item">
                                    <div class="depot-name">Dépôt Est</div>
                                    <div class="depot-count">368 équipements</div>
                                    <div class="depot-bar">
                                        <div class="depot-progress" style="width: 75%;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Real-time clock update
            function updateClock() {
                const now = new Date();
                const timeElements = document.querySelectorAll('.real-time');
                timeElements.forEach(el => {
                    el.textContent = now.toLocaleString('fr-FR');
                });
            }
            
            // Update every minute
            setInterval(updateClock, 60000);
            
            // Auto-refresh dashboard stats every 5 minutes
            setInterval(function() {
                fetch('{{ path('dashboard_refresh') }}')
                    .then(response => response.json())
                    .then(data => {
                        // Update stats without page reload
                        Object.keys(data).forEach(key => {
                            const element = document.querySelector(`[data-stat="${key}"]`);
                            if (element) {
                                element.textContent = data[key];
                            }
                        });
                    })
                    .catch(error => console.log('Auto-refresh error:', error));
            }, 300000);

            // Add smooth animations on page load
            const cards = document.querySelectorAll('.dashboard-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
{% endblock %}